				TweenService:Create(
					iconScale,
					TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Scale = 0.78 }
				):Play()
				TweenService:Create(component, TweenInfo.new(0.09), { BackgroundColor3 = Color3.fromRGB(44, 44, 48) })
					:Play()
				task.delay(0.09, function()
					TweenService:Create(
						iconScale,
						TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
						{ Scale = 1 }
					):Play()
					TweenService
						:Create(component, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(39, 39, 42) })
						:Play()
				end)
				if type(buttonConfig.Callback) == "function" then
					task.spawn(buttonConfig.Callback)
				end
			end
			component.MouseButton1Click:Connect(function()
				api:Fire()
			end)
			component.MouseEnter:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(38, 38, 41) })
					:Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.9 }):Play()
