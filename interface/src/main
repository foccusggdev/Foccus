frame.HeaderDivider.Visible = false
make("Frame",frame,{Name="HeaderTopSeparator",Position=UDim2.fromOffset(16,5),Size=UDim2.new(1,-32,0,1),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=.975,BorderSizePixel=0,ZIndex=3})
make("Frame",frame,{Name="TabsSeparator",Position=UDim2.fromOffset(219,68),Size=UDim2.new(0,1,1,-84),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=.975,BorderSizePixel=0,ZIndex=3})
local originalAddTab=window.AddTab
local sidebarOrder=0
function window:SectionTab(config)
 local title=type(config)=="table" and config.Title or config
 sidebarOrder+=1
 local section=make("TextLabel",sidebar,{
  Name="SectionTab",Size=UDim2.new(1,-8,0,25),LayoutOrder=sidebarOrder,
  BackgroundTransparency=1,Text=tostring(title or "Section"),
  Font=Enum.Font.GothamMedium,TextSize=13,TextColor3=Color3.fromRGB(155,155,155),
