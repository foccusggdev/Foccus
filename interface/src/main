 })
 make("UIPadding",section,{PaddingLeft=UDim.new(0,10),PaddingTop=UDim.new(0,5)})
 animate(section,.35,{TextTransparency=0})
 return section
end
window.AddSectionTab=window.SectionTab
local tabViews={}
local selectedTab
local function paint(view)
 local selected=selectedTab==view.Tab
 animate(view.Button,.25,{Position=UDim2.fromOffset(0,selected and -2 or 0),BackgroundTransparency=1})
 animate(view.Title,.2,{TextColor3=Color3.fromRGB(view.Hover and 255 or selected and 245 or 145,view.Hover and 255 or selected and 245 or 145,view.Hover and 255 or selected and 245 or 145)})
 local gray=view.Hover and 205 or selected and 185 or 95
 animate(view.Description,.2,{TextColor3=Color3.fromRGB(gray,gray,gray)})
 animate(view.Icon,.2,{ImageTransparency=selected and 0 or view.Hover and .05 or .3})
end
function window:SelectTab(tab)
 selectedTab=tab self._selected=tab
 for _,other in ipairs(self._tabs) do other.Page.Visible=other==tab end
 tab.Page.Visible=true
 for _,view in ipairs(tabViews) do paint(view) end
end
function window:AddTab(config)
 local tab=originalAddTab(self,{Title=config.Title,Description=config.Description})
 tab.Button.Visible=false
 sidebarOrder+=1
 local slot=make("Frame",sidebar,{Name=config.Title.."Slot",Size=UDim2.new(1,-8,0,41),BackgroundTransparency=1,LayoutOrder=sidebarOrder,ZIndex=4})
 local row=make("TextButton",slot,{Name="TabButton",Position=UDim2.fromOffset(-28,0),Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(31,32,33),BackgroundTransparency=1,BorderSizePixel=0,Text="",AutoButtonColor=false,ZIndex=5})
 make("UICorner",row,{CornerRadius=UDim.new(0,8)})
 local image=make("ImageLabel",row,{Name="Icon",Visible=false,Position=UDim2.fromOffset(11,10),Size=UDim2.fromOffset(23,23),BackgroundTransparency=1,Image=lucide[config.Icon] or lucide["layout-grid"],ImageTransparency=1,ZIndex=6})
 local title=make("TextLabel",row,{Name="Title",Position=UDim2.fromOffset(10,6),Size=UDim2.new(1,-20,0,20),BackgroundTransparency=1,Text=config.Title,Font=Enum.Font.GothamBold,TextSize=15,TextColor3=Color3.fromRGB(145,145,145),TextTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=6})
 local clip=make("Frame",row,{Name="DescriptionClip",Position=UDim2.fromOffset(10,23),Size=UDim2.new(1,-20,0,17),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=6})
 local description=make("TextLabel",clip,{Name="Description",Size=UDim2.fromScale(1,1),AutomaticSize=Enum.AutomaticSize.X,BackgroundTransparency=1,Text=config.Description or "",Font=Enum.Font.GothamMedium,TextSize=13,TextColor3=Color3.fromRGB(95,95,95),TextTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=7})
 local view={Tab=tab,Button=row,Title=title,Description=description,Icon=image,Hover=false,Clip=clip,Clock=0,Overflow=0}
 table.insert(tabViews,view)
 row.MouseEnter:Connect(function() view.Hover=true paint(view) end)
 row.MouseLeave:Connect(function() view.Hover=false paint(view) end)
 row.Activated:Connect(function() self:SelectTab(tab) end)
 if not selectedTab then self:SelectTab(tab) end
 animate(row,.42,{Position=UDim2.fromOffset(0,selectedTab==tab and -2 or 0),BackgroundTransparency=1})
 animate(title,.4,{TextTransparency=0}) animate(description,.4,{TextTransparency=0})
 animate(image,.4,{ImageTransparency=selectedTab==tab and 0 or .3})
 return tab
end

track(game:GetService("RunService").Heartbeat,function(dt)
 if not frame.Visible then return end
 for _,view in ipairs(tabViews) do
  local overflow=math.max(0,view.Description.TextBounds.X-view.Clip.AbsoluteSize.X)
  if math.abs(overflow-view.Overflow)>1 then view.Clock=0 view.Overflow=overflow end
  if overflow>1 then
   view.Clock+=dt
   local travel=math.max(2,overflow/23)
   local t=view.Clock%(travel+2.8)
   local x=0
   if t>=1.1 and t<1.1+travel then x=overflow*(t-1.1)/travel
   elseif t>=1.1+travel and t<2.2+travel then x=overflow
   elseif t>=2.2+travel and t<2.5+travel then
    x=overflow
   end
   if t>=2.2+travel and t<2.5+travel then
    view.Description.TextTransparency=math.clamp((t-2.2-travel)/.3,0,1)
   elseif t>=2.5+travel then
    view.Description.TextTransparency=1-math.clamp((t-2.5-travel)/.3,0,1)
   elseif view.Clock>.5 then
    view.Description.TextTransparency=0
   end
   view.Description.Position=UDim2.fromOffset(-x/frame.ResponsiveScale.Scale,0)
  else view.Description.Position=UDim2.new() if view.Clock>.5 then view.Description.TextTransparency=0 end end
 end
end)
local searchFrame=make("Frame",frame,{Name="SearchBar",Position=UDim2.fromOffset(22,68),Size=UDim2.fromOffset(186,30),BackgroundColor3=Color3.fromRGB(22,22,22),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,ZIndex=15})
local searchLine=make("Frame",searchFrame,{Name="InputLine",Position=UDim2.new(0,0,1,-1),Size=UDim2.new(1,0,0,1),BackgroundColor3=Color3.fromRGB(150,150,150),BackgroundTransparency=.82,BorderSizePixel=0,ZIndex=18})
make("ImageLabel",searchFrame,{Name="SearchIcon",Position=UDim2.fromOffset(8,6),Size=UDim2.fromOffset(18,18),Image=lucide.search,ImageColor3=Color3.fromRGB(165,165,165),BackgroundTransparency=1,ZIndex=16})
make("UIGradient",searchLine,{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.22,.12),NumberSequenceKeypoint.new(.5,0),NumberSequenceKeypoint.new(.78,.12),NumberSequenceKeypoint.new(1,1)})})
local inputClip=make("Frame",searchFrame,{Name="InputClip",Position=UDim2.fromOffset(34,0),Size=UDim2.new(1,-42,1,0),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=16})
local search=make("TextBox",inputClip,{Name="SearchInput",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Text="",PlaceholderText="Search...",PlaceholderColor3=Color3.fromRGB(116,116,116),TextColor3=Color3.fromRGB(230,230,230),Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,MultiLine=false,TextWrapped=false,TextTruncate=Enum.TextTruncate.None,ClipsDescendants=true,ZIndex=17})

search.Focused:Connect(function() animate(searchLine,.2,{BackgroundTransparency=.55}) end)
search.FocusLost:Connect(function() animate(searchLine,.2,{BackgroundTransparency=.82}) end)
local function normalize(text)
 text=string.lower(text)
 for _,pair in ipairs({{"á","a"},{"à","a"},{"â","a"},{"ã","a"},{"é","e"},{"ê","e"},{"í","i"},{"ó","o"},{"ô","o"},{"õ","o"},{"ú","u"},{"ç","c"},{"Í","i"},{"Á","a"},{"É","e"},{"Ç","c"}}) do text=string.gsub(text,pair[1],pair[2]) end
 return text
end
local function filterComponents()
 local query=normalize(search.Text):match("^%s*(.-)%s*$")
 local firstMatch, selectedMatches
 for _,view in ipairs(tabViews) do
  local matchesInTab=0
  local section, sectionMatches
  local items={}
  for _,item in ipairs(view.Tab.Page:GetChildren()) do
   if item:IsA("GuiObject") then table.insert(items,item) end
  end
  table.sort(items,function(a,b) return a.LayoutOrder<b.LayoutOrder end)
  for _,item in ipairs(items) do
   if item:IsA("TextLabel") then
    if section then section.Visible=query=="" or sectionMatches end
    section=item sectionMatches=false
   else
    local texts={}
    for _,label in ipairs(item:GetDescendants()) do
     if label:IsA("TextLabel") or label:IsA("TextButton") then
      table.insert(texts,label.Text)
     elseif label:IsA("TextBox") then
      table.insert(texts,label.PlaceholderText)
      table.insert(texts,label.Text)
     end
    end
    local content=normalize(table.concat(texts," "))
    local matches=true
    for word in query:gmatch("%S+") do
     if not content:find(word,1,true) then matches=false break end
    end
    item.Visible=matches
    if matches then matchesInTab+=1 sectionMatches=true end
   end
  end
  if section then section.Visible=query=="" or sectionMatches end
  view.Button.Parent.Visible=query=="" or matchesInTab>0
  if matchesInTab>0 then
   firstMatch=firstMatch or view.Tab
   if selectedTab==view.Tab then selectedMatches=true end
  end
  view.Tab.Page.CanvasPosition=Vector2.zero
 end
 if query~="" and not selectedMatches and firstMatch then window:SelectTab(firstMatch) end
 local ordered={}
 for _,child in ipairs(sidebar:GetChildren()) do
  if child:IsA("GuiObject") then table.insert(ordered,child) end
 end
 table.sort(ordered,function(a,b) return a.LayoutOrder<b.LayoutOrder end)
 local section,hasMatch=nil,false
 for _,item in ipairs(ordered) do
  if item.Name=="SectionTab" then
   if section then section.Visible=query=="" or hasMatch end
   section=item hasMatch=false
  elseif item.Visible then hasMatch=true end
 end
 if section then section.Visible=query=="" or hasMatch end
 sidebar.CanvasPosition=Vector2.zero
end
search:GetPropertyChangedSignal("Text"):Connect(filterComponents)

local closeDialog
frame.HeaderActions.Close.Activated:Connect(function()
 if closeDialog or busy then return end
 busy=true
 local layer=make("Frame",gui,{Name="CloseConfirmation",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=100})
 closeDialog=layer
 local blocker=make("TextButton",layer,{Name="InputBlocker",Size=UDim2.fromScale(1,1),Text="",BackgroundColor3=Color3.new(),BackgroundTransparency=1,AutoButtonColor=false,ZIndex=101})

 local frozen=make("Frame",layer,{Name="SoftWindow",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=102})
 local silhouette=make("Frame",frozen,{Position=frame.Position,AnchorPoint=frame.AnchorPoint,Size=frame.Size,BackgroundColor3=frame.BackgroundColor3,BorderSizePixel=0,ZIndex=1})
 make("UICorner",silhouette,{CornerRadius=UDim.new(0,12)})
 make("UIScale",silhouette,{Scale=frame.ResponsiveScale.Scale})
 for _,offset in ipairs({Vector2.new(-2,0),Vector2.new(2,0),Vector2.new(0,-2),Vector2.new(0,2),Vector2.new(-1,-1),Vector2.new(1,1)}) do
  local group=make("CanvasGroup",frozen,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,GroupTransparency=.78,ZIndex=2})
  local copy=frame:Clone()
  copy.Name="BlurSample" copy.Position=frame.Position+UDim2.fromOffset(offset.X,offset.Y)
  copy.Parent=group
  for _,o in ipairs(copy:GetDescendants()) do
   if o:IsA("GuiObject") then o.Active=false o.Selectable=false end
   if o:IsA("GuiButton") then o.Interactable=false end
   if o:IsA("TextBox") then o.TextEditable=false end
  end
 end
 frame.Visible=false
 local shade=make("Frame",layer,{Position=frame.Position,AnchorPoint=frame.AnchorPoint,Size=frame.Size,BackgroundColor3=Color3.new(),BackgroundTransparency=.72,BorderSizePixel=0,ZIndex=103})
 make("UICorner",shade,{CornerRadius=UDim.new(0,12)})
 make("UIScale",shade,{Scale=frame.ResponsiveScale.Scale})
 local dialog=make("Frame",layer,{Name="Dialog",AnchorPoint=Vector2.new(.5,.5),Position=frame.Position,Size=UDim2.fromOffset(420,166),BackgroundColor3=Color3.fromRGB(20,20,21),BorderSizePixel=0,ZIndex=110})
 make("UICorner",dialog,{CornerRadius=UDim.new(0,12)})
 local scale=make("UIScale",dialog,{Scale=frame.ResponsiveScale.Scale})
 make("TextLabel",dialog,{Name="Message",Position=UDim2.fromOffset(26,24),Size=UDim2.new(1,-52,0,65),Text="You want to close Foccus.gg completely, this will terminate the functions.",TextWrapped=true,Font=Enum.Font.GothamMedium,TextSize=15,TextColor3=Color3.fromRGB(235,235,235),BackgroundTransparency=1,ZIndex=111})
 local function choice(text,x)
  local b=make("TextButton",dialog,{Name=text,Position=UDim2.fromOffset(x,111),Size=UDim2.fromOffset(172,34),Text=text,Font=Enum.Font.GothamMedium,TextSize=14,TextColor3=Color3.fromRGB(230,230,230),BackgroundColor3=Color3.fromRGB(27,27,27),BorderSizePixel=0,AutoButtonColor=false,ZIndex=112})
  make("UICorner",b,{CornerRadius=UDim.new(0,7)})
  b.MouseEnter:Connect(function() animate(b,.18,{BackgroundColor3=Color3.fromRGB(37,37,37)}) end)
  b.MouseLeave:Connect(function() animate(b,.18,{BackgroundColor3=Color3.fromRGB(27,27,27)}) end)
  return b
 end
 local yes=choice("Yes",26)
 local cancel=choice("Cancel",222)
 local choosing=false
  local function fadeTree(root,duration)
  for _,o in ipairs(root:GetDescendants()) do
   if o:IsA("CanvasGroup") then animate(o,duration,{GroupTransparency=1})
   elseif o:IsA("GuiObject") then
    local props={BackgroundTransparency=1}
    if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then props.TextTransparency=1 end
    if o:IsA("ImageLabel") or o:IsA("ImageButton") then props.ImageTransparency=1 end
    animate(o,duration,props)
   end
  end
 end
 dialog.Position=frame.Position+UDim2.fromOffset(0,5)
 animate(dialog,.25,{Position=frame.Position})
 cancel.Activated:Connect(function()
  if choosing then return end choosing=true
  fadeTree(dialog,.2)
  animate(dialog,.2,{BackgroundTransparency=1})
  animate(dialog,.2,{Position=frame.Position+UDim2.fromOffset(0,4)}).Completed:Wait()
  if not gui.Parent then return end
  frame.Visible=true layer:Destroy() closeDialog=nil busy=false
 end)
 yes.Activated:Connect(function()
  if choosing then return end choosing=true

  fadeTree(layer,.48)
  animate(scale,.48,{Scale=frame.ResponsiveScale.Scale*.98})
  task.delay(.5,function() if gui.Parent then gui:Destroy() end end)
 end)
end)

do
 local TweenService=game:GetService("TweenService")
 local UIS=game:GetService("UserInputService")
 local connections={}
 local function connect(signal,fn) local c=signal:Connect(fn) table.insert(connections,c) return c end
 local function create(class,parent,props)
  local o=Instance.new(class) for k,v in pairs(props) do o[k]=v end o.Parent=parent return o
 end
 local minimized,transition=false,false
 local originalPosition,originalSize,originalClips
 local crop
 local toggle=create("TextButton",gui,{Name="MinimizedToggle",AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,18),Size=UDim2.fromOffset(148,46),Text="",BackgroundColor3=Color3.fromRGB(20,20,21),BorderSizePixel=0,AutoButtonColor=false,Visible=false,ZIndex=90,AutoLocalize=false})
 create("UICorner",toggle,{CornerRadius=UDim.new(0,9)})
 create("ImageLabel",toggle,{Name="MoveIcon",Position=UDim2.fromOffset(10,10),Size=UDim2.fromOffset(26,26),Image=getcustomasset("Foccus/icons/lucide-move.png"),BackgroundTransparency=1,ZIndex=91})
 create("TextLabel",toggle,{Name="Label",Position=UDim2.fromOffset(42,0),Size=UDim2.new(1,-50,1,0),Text="Toggle UI",Font=Enum.Font.GothamMedium,TextSize=19,TextColor3=Color3.fromRGB(235,235,235),BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=91,AutoLocalize=false})
 local function animate(object,props)
  local t=TweenService:Create(object,TweenInfo.new(.42,Enum.EasingStyle.Quint,Enum.EasingDirection.InOut),props) t:Play() return t
 end
 local function setMinimized(value)
  if transition or value==minimized or gui:FindFirstChild("CloseConfirmation") then return end
  transition=true
  if value then
   originalPosition,originalSize,originalClips=frame.Position,frame.Size,frame.ClipsDescendants
   local size=frame.AbsoluteSize
   crop=create("Frame",gui,{Name="MinimizeClip",AnchorPoint=Vector2.new(.5,.5),Position=originalPosition,Size=UDim2.fromOffset(size.X,size.Y),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=frame.ZIndex})
   frame.Parent=crop frame.Position=UDim2.fromScale(.5,.5)
   animate(crop,{Size=UDim2.fromOffset(size.X,0)}).Completed:Wait()
   if not gui.Parent then return end
   frame.Visible=false crop.Visible=false toggle.Visible=true minimized=true
  else
   toggle.Visible=false crop.Visible=true frame.Visible=true
   local scale=frame.ResponsiveScale.Scale
   animate(crop,{Size=UDim2.fromOffset(originalSize.X.Offset*scale,originalSize.Y.Offset*scale)}).Completed:Wait()
   if not gui.Parent then return end
   frame.Parent=gui frame.Position=originalPosition frame.Size=originalSize frame.ClipsDescendants=originalClips
   crop:Destroy() crop=nil minimized=false
  end
  gui:SetAttribute("Minimized",minimized)
  transition=false
 end
 connect(frame.HeaderActions.Reload.Activated,function()
  if transition or busy or minimized then return end
  setMinimized(true)
  if not gui.Parent then return end
  toggle.Visible=false
  setMinimized(false)
 end)
 connect(frame.HeaderActions.Minimize.Activated,function() setMinimized(true) end)
 connect(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() then return end
  if input.KeyCode==Enum.KeyCode.LeftControl or input.KeyCode==Enum.KeyCode.RightControl then setMinimized(not minimized) end
 end)
  local function fitToggle()
  local label=toggle.Label
  local width=math.ceil(label.TextBounds.X)
  if width>0 then
   label.Size=UDim2.new(0,width,1,0)
   toggle.Size=UDim2.fromOffset(42+width+10,46)
  end
 end
 connect(toggle.Label:GetPropertyChangedSignal("TextBounds"),fitToggle)
 task.defer(fitToggle)
 local drag,startInput,startPosition,moved,lastDragEnd
 connect(toggle.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   drag=input startInput=input.Position startPosition=toggle.Position moved=false
  end
 end)
 connect(UIS.InputChanged,function(input)
  if not drag or (input~=drag and input.UserInputType~=Enum.UserInputType.MouseMovement) then return end
  local delta=input.Position-startInput
  if delta.Magnitude>5 then moved=true end
  if not moved then return end
  local camera=workspace.CurrentCamera
  local viewport=camera and camera.ViewportSize or Vector2.new(1920,1080)
  local x=startPosition.X.Scale*viewport.X+startPosition.X.Offset+delta.X
  local y=startPosition.Y.Scale*viewport.Y+startPosition.Y.Offset+delta.Y
  toggle.Position=UDim2.fromOffset(math.clamp(x,toggle.AbsoluteSize.X/2,math.max(toggle.AbsoluteSize.X/2,viewport.X-toggle.AbsoluteSize.X/2)),math.clamp(y,0,math.max(0,viewport.Y-toggle.AbsoluteSize.Y)))
 end)
 connect(UIS.InputEnded,function(input)
  if drag and (input==drag or input.UserInputType==Enum.UserInputType.MouseButton1) then
   if moved then lastDragEnd=os.clock() end drag=nil
  end
 end)
 connect(toggle.Activated,function()
  if moved or (lastDragEnd and os.clock()-lastDragEnd<.15) then return end
  setMinimized(false)
 end)
 connect(gui.Destroying,function() for _,c in ipairs(connections) do c:Disconnect() end end)
end

return window
end
return startUI()
