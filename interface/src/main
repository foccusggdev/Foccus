			icon.Name = "LucideMousePointerClick"
			icon.AnchorPoint = Vector2.new(1, 0.5)
			icon.Position = UDim2.new(1, -18, 0.5, 0)
			icon.Size = UDim2.fromOffset(20, 20)
			icon.BackgroundTransparency = 1
			icon.Image = getCustomIcon("Foccus/icons/lucide-mouse-pointer-click.png")
			icon.ImageColor3 = Color3.new(1, 1, 1)
			icon.ImageTransparency = 0.08
			local iconScale = Instance.new("UIScale", icon)

			local api = { Instance = component, Title = buttonTitle, Description = buttonDescription, Icon = icon }
