			sliderDescription.Size = UDim2.new(1, -205, 0, 18)
			sliderDescription.BackgroundTransparency = 1
			sliderDescription.FontFace = Ubuntu
			sliderDescription.Text = sliderConfig.Description or ""
			sliderDescription.TextColor3 = Color3.fromRGB(125, 125, 132)
			sliderDescription.TextSize = 13
			sliderDescription.TextXAlignment = Enum.TextXAlignment.Left
			sliderDescription.TextTruncate = Enum.TextTruncate.None

