			tabIcon.Position = UDim2.fromOffset(12, 13)
			tabIcon.Size = UDim2.fromOffset(19, 19)
			tabIcon.BackgroundTransparency = 1
			tabIcon.Image = getCustomIcon(config.Icon)
			tabIcon.ImageColor3 = Color3.fromRGB(155, 155, 155)
			tabIcon.ImageTransparency = 0.25
		end
		local tabPinStar = Instance.new("ImageLabel", button)
		tabPinStar.Name = "PinStar"
		tabPinStar.AnchorPoint = Vector2.new(1, 0)
		tabPinStar.Position = UDim2.new(1, -8, 0, 7)
		tabPinStar.Size = UDim2.fromOffset(15, 15)
		tabPinStar.BackgroundTransparency = 1
		tabPinStar.Image = getCustomIcon("lucide-star.png")
		tabPinStar.ImageColor3 = Color3.fromRGB(225, 225, 230)
		tabPinStar.Visible = false
		tabPinStar.ZIndex = 5

		local tabTitle = Instance.new("TextLabel", button)
		tabTitle.Name = "Title"
		tabTitle.Position = UDim2.fromOffset(textOffset, 3)
		tabTitle.Size = UDim2.new(1, -textOffset - 8, 0, 22)
		tabTitle.BackgroundTransparency = 1
		tabTitle.FontFace = Ubuntu
		tabTitle.Text = config.Title or "Tab"
		tabTitle.TextColor3 = Color3.fromRGB(150, 150, 155)
		tabTitle.TextSize = 18
		tabTitle.TextXAlignment = Enum.TextXAlignment.Left
		tabTitle.TextStrokeColor3 = Color3.new(1, 1, 1)
		tabTitle.TextStrokeTransparency = 1

		local tabDescription = Instance.new("TextLabel", button)
		tabDescription.Name = "Description"
		tabDescription.Position = UDim2.fromOffset(textOffset, 24)
		tabDescription.Size = UDim2.new(1, -textOffset - 8, 0, 18)
		tabDescription.BackgroundTransparency = 1
		tabDescription.FontFace = Ubuntu
		tabDescription.Text = config.Description or ""
		tabDescription.TextColor3 = Color3.fromRGB(105, 105, 110)
