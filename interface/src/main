\057\014\091\085\232\054\103\192\171\042\245\034\149\187\049\028\142\054\064\088\166\146\219\005\162\194\232\064\070\080\054\187\252\117\245\061\183\180\017\188\050\149\091\195\087\017\194\050\149\156\011\215\056\136\085\096\044\002\050\130\178\209\245\078\005\224\054\151\064\231\224\229\194\043\101\042\183\150\124\021\036\097\153\074\206\217\134\141\130\168\048\022\001\089\004\103\110\229\158\031\001\247\182\125\166\086\193\043\083\185\181\218\045\129\176\017\105\088\004\098\021\024\139\128\116\040\163\021\129\021\173\183\043\000\183\169\004\058\007\047\167\110\011\165\222\134\183\249\154\176\011\171\072\195\070\065\204\193\232\064\070\080\054\186\252\245\054\149\064\247\155\038\192\043\146\122\181\179\209\070\149\092\021\068\183\017\171\194\152\131\050\002\179\108\069\175\225\239\243\155\010\208\069\170\182\012\188\090\229\174\130\052\108\004\196\072\042\042\140\014\100\004\101\025\164\101\143\247\215\255\117\000\093\078\218\085\001\175\150\122\171\104\027\054\003\098\004\099\017\144\057\048\027\093\209\107\070\192\253\042\128\174\105\240\106\091\111\117\212\114\017\136\085\097\044\002\178\012\206\162\149\123\157\008\184\095\086\128\174\010\120\181\135\187\206\065\084\024\139\128\116\040\163\085\004\086\180\126\089\001\184\095\004\208\213\224\189\002\106\217\065\044\130\049\146\140\017\144\057\048\027\093\209\107\254\162\073\232\126\018\073\188\090\221\190\026\032\150\193\152\131\178\008\206\162\149\123\029\127\191\159\021\064\087\131\183\001\096\116\032\115\096\086\129\180\232\057\209\123\252\067\013\221\198\000\049\130\177\008\200\034\048\155\089\209\107\255\052\144\114\145\138\173\213\236\107\012\163\003\233\080\022\193\089\101\069\175\229\239\247\086\013\221\198\131\177\008\200\008\202\042\144\070\112\021\193\246\086\036\229\106\135\098\003\029\005\064\230\192\108\118\069\175\253\102\013\092\125\020\001\089\006\103\149\021\190\094\125\218\235\163\093\082\179\134\171\062\234\163\062\234\163\062\234\163\062\234\163\062\234\163\062\234\163\062\234\163\062\222\168