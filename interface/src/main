local env = getgenv()
if env.__FoccusStandaloneCleanup then env.__FoccusStandaloneCleanup() end
local callbacks = {}
local alive = true
local STATE = {}
function STATE.alive() return alive end
function STATE.onCleanup(callback) table.insert(callbacks, callback) end
local function teardown()
 if not alive then return end
 alive = false
 for i = #callbacks, 1, -1 do pcall(callbacks[i]) end
 table.clear(callbacks)
end
env.__FoccusStandaloneCleanup = teardown
local startUI
startUI = function()

local connections = {}
local function track(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end
local function cleanup()
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
end
local Library = (function()
local Library = {}

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Ubuntu = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
local UbuntuMedium = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)

local bundledIcons = {
	["lucide-pin.png"] = "",
	["lucide-pin-off.png"] = "",
	["lucide-arrow-up.png"] = "",
	["lucide-arrow-down.png"] = "",
	["lucide-star.png"] = "",
}

local function getCustomIcon(path)
	if bundledIcons[path] then
		pcall(function()
			if not isfile(path) then
				writefile(path, base64_decode(bundledIcons[path]))
			end
		end)
	end
	local ok, asset = pcall(function()
		return getcustomasset(path)
	end)
	return ok and asset or ""
end

local function animateIn(object, interactive, entrance)
	local scale = Instance.new("UIScale", object)
	scale.Scale = entrance == false and 1 or 0.975
	local shadow
	if object:IsA("Frame") or object:IsA("TextButton") then
		pcall(function()
			shadow = Instance.new("UIShadow", object)
			shadow.Name = "DepthShadow"
			shadow.BlurRadius = UDim.new(0, 7)
			shadow.Color = Color3.new()
			shadow.Transparency = 0.95
			shadow.ZIndex = -1
			shadow.ShowBehindParent = true
		end)
	end
	if entrance ~= false then
		task.defer(function()
			if object.Parent then
				TweenService
					:Create(scale, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 })
					:Play()
			end
		end)
	end
	if interactive ~= false and shadow then
		object.MouseEnter:Connect(function()
			local info = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			TweenService:Create(scale, info, { Scale = 1.002 }):Play()
			TweenService:Create(shadow, info, { Transparency = 0.86 }):Play()
		end)
		object.MouseLeave:Connect(function()
			local info = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			TweenService:Create(scale, info, { Scale = 1 }):Play()
			TweenService:Create(shadow, info, { Transparency = 0.95 }):Play()
		end)
	end
	return scale, shadow
end

local function getParent()
	local ok, result = pcall(function()
		return gethui()
	end)
	return (ok and result) or CoreGui
end

local function showLoading(parent, options)
	if options.Loading == false then
		return
	end

	local previousGui = parent:FindFirstChild("FoccusLoadingUI")
	if previousGui then
		previousGui:Destroy()
	end
	local previousBlur = Lighting:FindFirstChild("FoccusLoadingBlur")
	if previousBlur then
		previousBlur:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "FoccusLoadingUI"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100000
	gui.Parent = parent

	local title = Instance.new("TextLabel")
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.5)
	title.Size = UDim2.fromOffset(360, 72)
	title.BackgroundTransparency = 1
	title.FontFace = UbuntuMedium
	title.Text = options.LoadingTitle or options.Title or "Foccus.gg"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextSize = 36
	title.TextTransparency = 1
	title.Parent = gui

	local blur = Instance.new("BlurEffect")
	blur.Name = "FoccusLoadingBlur"
	blur.Size = 0
	blur.Parent = Lighting

	TweenService:Create(blur, TweenInfo.new(0.25), { Size = 56 }):Play()
	TweenService:Create(title, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	task.wait(tonumber(options.LoadingDuration) or 2)
	TweenService:Create(blur, TweenInfo.new(0.3), { Size = 0 }):Play()
	TweenService:Create(title, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
	task.wait(0.3)
	gui:Destroy()
	blur:Destroy()
end

function Library:CreateWindow(options)
	options = options or {}
	local parent = getParent()
	showLoading(parent, options)
	local previous = parent:FindFirstChild("FoccusLibraryUI")
	if previous then
		previous:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "FoccusLibraryUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.Name = "Window"
	local targetPosition = options.Position or UDim2.new(0.163321942, 0, 0.229966149, 0)
	frame.Position =
		UDim2.new(targetPosition.X.Scale, targetPosition.X.Offset, targetPosition.Y.Scale, targetPosition.Y.Offset + 10)
	frame.Size = options.Size or UDim2.fromOffset(630, 382)
	frame.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Parent = gui
	local responsiveScale = Instance.new("UIScale")
	responsiveScale.Name = "ResponsiveScale"
	responsiveScale.Parent = frame
	local function updateResponsiveScale()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
		local width = math.max(frame.Size.X.Offset, 1)
		local height = math.max(frame.Size.Y.Offset, 1)
		responsiveScale.Scale = math.min((viewport.X - 24) / width, (viewport.Y - 24) / height, 1)
	end
	updateResponsiveScale()
	track(workspace:GetPropertyChangedSignal("CurrentCamera"), updateResponsiveScale)
	if workspace.CurrentCamera then
		track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), updateResponsiveScale)
	end
	local corner = Instance.new("UICorner", frame)
	corner.CornerRadius = UDim.new(0, 8)
	pcall(function()
		local shadow = Instance.new("UIShadow", frame)
		shadow.BlurRadius = UDim.new(0, 24)
		shadow.Color = Color3.new()
		shadow.Transparency = 0.58
		shadow.ZIndex = -1
		shadow.ShowBehindParent = true
	end)

	local title = Instance.new("TextLabel", frame)
	title.Name = "Title"
	title.Position = UDim2.fromOffset(0, 11)
	title.Size = UDim2.new(1, 0, 0, 30)
	title.BackgroundTransparency = 1
	title.FontFace = Ubuntu
	title.Text = options.Title or "Foccus.gg"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextSize = 25
	title.TextXAlignment = Enum.TextXAlignment.Center

	local description = Instance.new("TextLabel", frame)
	description.Name = "Description"
	description.Position = UDim2.fromOffset(12, 29)
	description.Size = UDim2.fromOffset(200, 20)
	description.BackgroundTransparency = 1
	description.FontFace = Ubuntu
	description.Text = ""
	description.TextColor3 = Color3.new(1, 1, 1)
	description.TextTransparency = 0.34
	description.TextSize = 15
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.Visible = false

	local headerDivider = Instance.new("Frame", frame)
	headerDivider.Name = "HeaderDivider"
	headerDivider.Position = UDim2.fromOffset(12, 52)
	headerDivider.Size = UDim2.new(1, -24, 0, 1)
	headerDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	headerDivider.BackgroundTransparency = 0.96
	headerDivider.BorderSizePixel = 0

	local contentDivider = Instance.new("Frame", frame)
	contentDivider.Name = "ContentDivider"
	contentDivider.Position = UDim2.fromOffset(190, 62)
	contentDivider.Size = UDim2.new(0, 1, 1, -74)
	contentDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	contentDivider.BackgroundTransparency = 0.97
	contentDivider.BorderSizePixel = 0

	local tabs = Instance.new("ScrollingFrame", frame)
	tabs.Name = "Tabs"
	tabs.Position = UDim2.fromOffset(12, 60)
	tabs.Size = UDim2.new(0, 170, 1, -72)
	tabs.BackgroundTransparency = 1
	tabs.BorderSizePixel = 0
	tabs.ScrollBarThickness = 0
	tabs.AutomaticCanvasSize = Enum.AutomaticSize.Y
	tabs.CanvasSize = UDim2.new()
	local tabLayout = Instance.new("UIListLayout", tabs)
	tabLayout.Padding = UDim.new(0, 1)
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder

	local pages = Instance.new("Frame", frame)
	pages.Name = "Pages"
	pages.Position = UDim2.fromOffset(195, 60)
	pages.Size = UDim2.new(1, -207, 1, -72)
	pages.BackgroundTransparency = 1

	local Window = {
		Gui = gui,
		Frame = frame,
		Title = title,
		Description = description,
		Tabs = tabs,
		Pages = pages,
		_tabs = {},
		_selected = nil,
		_contextMenu = false :: any,
	}
	Window._notifications = {}
	local function positionNotifications()
		local total = #Window._notifications
		for index, entry in ipairs(Window._notifications) do
			local offset = 18 + (total - index) * 72
			TweenService:Create(
				entry.Frame,
				TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ Position = UDim2.new(1, -18, 1, -offset) }
			):Play()
		end
	end
	local function removeNotification(entry)
		local index = table.find(Window._notifications, entry)
		if not index then
			return
		end
		table.remove(Window._notifications, index)
		local tween = TweenService:Create(
			entry.Frame,
			TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{ Position = UDim2.new(1, 330, entry.Frame.Position.Y.Scale, entry.Frame.Position.Y.Offset) }
		)
		tween:Play()
		task.spawn(function()
			tween.Completed:Wait()
			entry.Frame:Destroy()
		end)
		positionNotifications()
	end
	function Window:Notify(config)
		config = config or {}
		local titleText = tostring(config.Title or "Notification")
		local descriptionText = tostring(config.Description or "")
		local signature = titleText .. "\0" .. descriptionText
		local duration = tonumber(config.Duration) or 3

		for _, entry in ipairs(self._notifications) do
			if entry.Signature == signature and entry.Frame.Parent then
				entry.Count += 1
				entry.Generation += 1
				entry.Counter.Text = tostring(entry.Count) .. "x"
				entry.Counter.Visible = true
				local generation = entry.Generation
				task.delay(duration, function()
					if entry.Generation == generation then
						removeNotification(entry)
					end
				end)
				return entry.Frame
			end
		end

		local notification = Instance.new("Frame")
		notification.Name = "Notification"
		notification.AnchorPoint = Vector2.new(1, 1)
		notification.Position = UDim2.new(1, 330, 1, -18)
		notification.Size = UDim2.fromOffset(288, 64)
		notification.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
		notification.BorderSizePixel = 0
		notification.ZIndex = 50
		notification.Parent = gui

		local notificationCorner = Instance.new("UICorner", notification)
		notificationCorner.CornerRadius = UDim.new(0, 8)
		local notificationStroke = Instance.new("UIStroke", notification)
		notificationStroke.Color = Color3.new(1, 1, 1)
		notificationStroke.Transparency = 0.9

		local notificationTitle = Instance.new("TextLabel", notification)
		notificationTitle.Position = UDim2.fromOffset(13, 7)
		notificationTitle.Size = UDim2.new(1, -66, 0, 20)
		notificationTitle.BackgroundTransparency = 1
		notificationTitle.Font = Enum.Font.GothamMedium
		notificationTitle.Text = titleText
		notificationTitle.TextColor3 = Color3.fromRGB(245, 245, 248)
		notificationTitle.TextSize = 16
		notificationTitle.TextXAlignment = Enum.TextXAlignment.Left
		notificationTitle.ZIndex = 51

		local counter = Instance.new("TextLabel", notification)
		counter.AnchorPoint = Vector2.new(1, 0)
		counter.Position = UDim2.new(1, -13, 0, 7)
		counter.Size = UDim2.fromOffset(38, 20)
		counter.BackgroundTransparency = 1
		counter.FontFace = UbuntuMedium
		counter.Text = ""
		counter.TextColor3 = Color3.fromRGB(205, 205, 212)
		counter.TextSize = 13
		counter.TextXAlignment = Enum.TextXAlignment.Right
		counter.Visible = false
		counter.ZIndex = 51

		local notificationDescription = Instance.new("TextLabel", notification)
		notificationDescription.Position = UDim2.fromOffset(13, 27)
		notificationDescription.Size = UDim2.new(1, -26, 0, 29)
		notificationDescription.BackgroundTransparency = 1
		notificationDescription.Font = Enum.Font.Gotham
		notificationDescription.Text = descriptionText
		notificationDescription.TextColor3 = Color3.fromRGB(155, 155, 162)
		notificationDescription.TextSize = 13
		notificationDescription.TextWrapped = true
		notificationDescription.TextXAlignment = Enum.TextXAlignment.Left
		notificationDescription.TextYAlignment = Enum.TextYAlignment.Top
		notificationDescription.ZIndex = 51

		local entry = {
			Frame = notification,
			Counter = counter,
			Signature = signature,
			Count = 1,
			Generation = 1,
		}
		table.insert(self._notifications, entry)
		positionNotifications()
		local generation = entry.Generation
		task.delay(duration, function()
			if entry.Generation == generation then
				removeNotification(entry)
			end
		end)
		return notification
	end
	Window._config = {}
	Window._configEnabled = options.AutoSave ~= false
	Window._configFolder = options.ConfigFolder or "Foccus"
	Window._configName = options.ConfigName
		or string.gsub(string.lower(options.Title or "window"), "[^%w%-_]", "-") .. ".json"
	Window._configPath = Window._configFolder .. "/" .. Window._configName
	if Window._configEnabled then
		pcall(function()
			if not isfolder(Window._configFolder) then
				makefolder(Window._configFolder)
			end
			if isfile(Window._configPath) then
				local decoded = HttpService:JSONDecode(readfile(Window._configPath))
				if type(decoded) == "table" then
					Window._config = decoded
				end
			end
		end)
	end
	function Window:GetConfig(flag, fallback)
		local value = self._config[flag]
		return value == nil and fallback or value
	end
	function Window:SaveConfig(flag, value)
		if not self._configEnabled or not flag then
			return
		end
		self._config[flag] = value
		pcall(function()
			writefile(self._configPath, HttpService:JSONEncode(self._config))
		end)
	end

	function Window:_refreshTabOrder()
		for index, tab in ipairs(self._tabs) do
			tab.Button.LayoutOrder = index
		end
	end

	function Window:_moveTab(tab, direction)
		local index = table.find(self._tabs, tab)
		local target = index and index + direction
		local neighbour = target and self._tabs[target]
		if not index or not neighbour or neighbour.Pinned ~= tab.Pinned then
			return
		end
		self._tabs[index], self._tabs[target] = self._tabs[target], self._tabs[index]
		self:_refreshTabOrder()
	end

	function Window:_setTabPinned(tab, pinned)
		local index = table.find(self._tabs, tab)
		if not index then
			return
		end
		table.remove(self._tabs, index)
		tab.Pinned = pinned == true
		if tab.PinStar then
			tab.PinStar.Visible = tab.Pinned
		end
		local insertAt = 1
		while self._tabs[insertAt] and self._tabs[insertAt].Pinned do
			insertAt += 1
		end
		table.insert(self._tabs, insertAt, tab)
		self:_refreshTabOrder()
	end

	function Window:_showTabMenu(tab, pointerPosition, actions)
		if not tab then
			return
		end
		if self._contextMenu then
			self._contextMenu:Destroy()
		end
		local menu = Instance.new("Frame")
		menu.Name = "TabContextMenu"
		menu.Size = UDim2.fromOffset(148, 104)
		menu.BackgroundColor3 = Color3.fromRGB(30, 30, 33)
		menu.BorderSizePixel = 0
		menu.ZIndex = 100
		menu.Parent = gui
		self._contextMenu = menu
		local menuCorner = Instance.new("UICorner", menu)
		menuCorner.CornerRadius = UDim.new(0, 7)
		local menuStroke = Instance.new("UIStroke", menu)
		menuStroke.Color = Color3.new(1, 1, 1)
		menuStroke.Transparency = 0.9
		local menuPadding = Instance.new("UIPadding", menu)
		menuPadding.PaddingTop = UDim.new(0, 4)
		menuPadding.PaddingBottom = UDim.new(0, 4)
		menuPadding.PaddingLeft = UDim.new(0, 4)
		menuPadding.PaddingRight = UDim.new(0, 4)
		local menuLayout = Instance.new("UIListLayout", menu)
		menuLayout.Padding = UDim.new(0, 2)

		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
		local point = pointerPosition or Vector2.new(tab.Button.AbsolutePosition.X + tab.Button.AbsoluteSize.X, tab.Button.AbsolutePosition.Y)
		menu.Position = UDim2.fromOffset(math.clamp(point.X, 8, viewport.X - 156), math.clamp(point.Y, 8, viewport.Y - 112))

		local function addOption(iconPath, label, callback)
			local option = Instance.new("TextButton", menu)
			option.Size = UDim2.new(1, 0, 0, 30)
			option.BackgroundColor3 = Color3.fromRGB(43, 43, 47)
			option.BackgroundTransparency = 1
			option.BorderSizePixel = 0
			option.AutoButtonColor = false
			option.FontFace = Ubuntu
			option.Text = label
			option.TextColor3 = Color3.fromRGB(220, 220, 225)
			option.TextSize = 13
			option.TextXAlignment = Enum.TextXAlignment.Left
			option.ZIndex = 101
			local padding = Instance.new("UIPadding", option)
			padding.PaddingLeft = UDim.new(0, 34)
			local icon = Instance.new("ImageLabel", option)
			icon.Name = "Icon"
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, -24, 0.5, 0)
			icon.Size = UDim2.fromOffset(16, 16)
			icon.BackgroundTransparency = 1
			icon.Image = getCustomIcon(iconPath)
			icon.ImageColor3 = Color3.fromRGB(205, 205, 212)
			icon.ZIndex = 102
			local optionCorner = Instance.new("UICorner", option)
			optionCorner.CornerRadius = UDim.new(0, 5)
			option.MouseEnter:Connect(function()
				TweenService:Create(option, TweenInfo.new(0.14), { BackgroundTransparency = 0.35 }):Play()
			end)
			option.MouseLeave:Connect(function()
				TweenService:Create(option, TweenInfo.new(0.14), { BackgroundTransparency = 1 }):Play()
			end)
			option.MouseButton1Click:Connect(function()
				callback()
				if menu.Parent then
					menu:Destroy()
				end
				self._contextMenu = nil
			end)
		end

		addOption(tab.Pinned and "lucide-pin-off.png" or "lucide-pin.png", tab.Pinned and "Unpin" or "Pin", function()
			if actions then
				actions.Pin()
			else
				self:_setTabPinned(tab, not tab.Pinned)
			end
		end)
		addOption("lucide-arrow-up.png", "Move Up", function()
			if actions then
				actions.Move(-1)
			else
				self:_moveTab(tab, -1)
			end
		end)
		addOption("lucide-arrow-down.png", "Move Below", function()
			if actions then
				actions.Move(1)
			else
				self:_moveTab(tab, 1)
			end
		end)
	end

	function Window:SelectTab(tab)
		if self._selected == tab then
			return
		end
		local old = self._selected
		self._selected = tab
		if old then
			TweenService:Create(
				old.Title,
				TweenInfo.new(0.16),
				{ TextColor3 = Color3.fromRGB(150, 150, 155), TextStrokeTransparency = 1 }
			):Play()
			TweenService:Create(
				old.Description,
				TweenInfo.new(0.16),
				{ TextColor3 = Color3.fromRGB(105, 105, 110), TextStrokeTransparency = 1 }
			):Play()
			if old.Icon then
				TweenService:Create(
					old.Icon,
					TweenInfo.new(0.16),
					{ ImageColor3 = Color3.fromRGB(155, 155, 155), ImageTransparency = 0.25 }
				):Play()
			end
			TweenService:Create(
				old.Button,
				TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 1 }
			):Play()
			TweenService:Create(old.Stroke, TweenInfo.new(0.22), { Transparency = 1 }):Play()
			TweenService
				:Create(old.Scale, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 })
				:Play()
			if old.Shadow then
				TweenService:Create(old.Shadow, TweenInfo.new(0.22), { Transparency = 0.95 }):Play()
			end
			old.Page.Visible = false
		end
		tab.Page.Visible = true
		TweenService
			:Create(tab.Title, TweenInfo.new(0.16), { TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.7 })
			:Play()
		TweenService:Create(
			tab.Description,
			TweenInfo.new(0.16),
			{ TextColor3 = Color3.fromRGB(215, 215, 220), TextStrokeTransparency = 0.85 }
		):Play()
		if tab.Icon then
			TweenService
				:Create(tab.Icon, TweenInfo.new(0.16), { ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = 0 })
				:Play()
		end
		TweenService:Create(
			tab.Button,
			TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.9 }
		):Play()
		TweenService:Create(tab.Stroke, TweenInfo.new(0.24), { Transparency = 0.95 }):Play()
		TweenService
			:Create(tab.Scale, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1.003 })
			:Play()
		if tab.Shadow then
			TweenService:Create(tab.Shadow, TweenInfo.new(0.24), { Transparency = 0.82 }):Play()
		end
	end

	function Window:AddTab(config)
		if type(config) == "string" then
			config = { Title = config }
		end
		config = config or {}
		local button = Instance.new("TextButton", tabs)
		button.Name = (config.Title or "Tab") .. "Tab"
		button.Size = UDim2.new(1, -4, 0, 48)
		button.BackgroundColor3 = Color3.fromRGB(46, 46, 50)
		button.BackgroundTransparency = 1
		button.BorderSizePixel = 0
		button.Text = ""
		button.LayoutOrder = #self._tabs + 1
		local buttonCorner = Instance.new("UICorner", button)
		buttonCorner.CornerRadius = UDim.new(0, 6)
		local buttonStroke = Instance.new("UIStroke", button)
		buttonStroke.Color = Color3.new(1, 1, 1)
		buttonStroke.Transparency = 1
		local buttonScale, buttonShadow = animateIn(button, false, false)
		local tabIcon
		local textOffset = config.Icon and 40 or 12
		if config.Icon then
			tabIcon = Instance.new("ImageLabel", button)
