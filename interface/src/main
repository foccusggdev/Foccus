lucide.water = getcustomasset("Foccus/icons/water-reflection.png")

local UIS = game:GetService("UserInputService")
local function button(parent,name,position,size)
 return make("TextButton",parent,{Name=name,Position=position,Size=size,Text="",BackgroundColor3=Color3.fromRGB(27,27,27),BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,ZIndex=25})
end
local function icon(parent,name,z)
 local glow=make("ImageLabel",parent,{Name="Glow",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(36,36),BackgroundTransparency=1,Image=lucide[name.."-glow"],ImageTransparency=.88,ZIndex=z})
 local core=make("ImageLabel",parent,{Name="Icon",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(24,24),BackgroundTransparency=1,Image=lucide[name],ImageTransparency=0,ZIndex=z+1})
 local function hover(active)
  animate(core,.24,{Position=UDim2.new(.5,0,.5,active and -2 or 0),Rotation=active and -7 or 0})
  animate(glow,.24,{Position=UDim2.new(.5,0,.5,active and -2 or 0),Rotation=active and -7 or 0,ImageTransparency=active and .55 or .88})
 end
 parent.MouseEnter:Connect(function() hover(true) end)
 parent.MouseLeave:Connect(function() hover(false) end)
 return core,glow
end
local busy=false
local headerActions=make("Frame",frame,{
 Name="HeaderActions",AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-18,0,16),
 Size=UDim2.fromOffset(78,32),BackgroundTransparency=1,ZIndex=25,
})
make("UIListLayout",headerActions,{
 FillDirection=Enum.FillDirection.Horizontal,HorizontalAlignment=Enum.HorizontalAlignment.Right,
 VerticalAlignment=Enum.VerticalAlignment.Center,Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder,
})
for index,data in ipairs({{"Reload",Color3.fromRGB(111,179,124)},{"Minimize",Color3.fromRGB(223,183,91)},{"Close",Color3.fromRGB(222,99,96)}}) do
 local action=button(headerActions,data[1],UDim2.new(),UDim2.fromOffset(24,32))
 action.LayoutOrder=index
 local dot=make("Frame",action,{Name="Dot",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(11,11),BackgroundColor3=data[2],BorderSizePixel=0,ZIndex=26})
 make("UICorner",dot,{CornerRadius=UDim.new(1,0)})
 action.MouseEnter:Connect(function() animate(dot,.18,{BackgroundColor3=data[2]:Lerp(Color3.new(1,1,1),.15),Size=UDim2.fromOffset(12,12)}) end)
 action.MouseLeave:Connect(function() animate(dot,.2,{BackgroundColor3=data[2],Size=UDim2.fromOffset(11,11)}) end)
end
local headerTitle=make("TextLabel",frame,{
 Name="HeaderTitle",Position=UDim2.fromOffset(22,12),Size=UDim2.fromOffset(230,24),
 BackgroundTransparency=1,Text="Foccus.gg",Font=Enum.Font.GothamBold,TextSize=18,
 TextColor3=Color3.fromRGB(245,245,245),TextTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,
})
local headerDescription=make("TextLabel",frame,{
 Name="HeaderDescription",Position=UDim2.fromOffset(22,32),Size=UDim2.fromOffset(230,19),
 BackgroundTransparency=1,Text="Blox Fruits",Font=Enum.Font.GothamMedium,TextSize=14,
 TextColor3=Color3.fromRGB(235,235,235),TextTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,
 TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=10,
})
local function revealLogo()
 animate(headerTitle,.65,{TextTransparency=0})
 animate(headerDescription,.65,{TextTransparency=.35})
end

local resizing
for _,edge in ipairs({"Left","Right","Bottom","Top","BottomRight"}) do
    local positions={Left=UDim2.new(0,0,0,0),Right=UDim2.new(1,-6,0,0),Bottom=UDim2.new(0,0,1,-6),Top=UDim2.new(0,0,0,0),BottomRight=UDim2.new(1,-14,1,-14)}
    local sizes={Left=UDim2.new(0,6,1,0),Right=UDim2.new(0,6,1,0),Bottom=UDim2.new(1,0,0,6),Top=UDim2.new(1,0,0,6),BottomRight=UDim2.fromOffset(14,14)}
    local hit=button(frame,"Resize"..edge,positions[edge],sizes[edge]) hit.ZIndex=60
    hit.InputBegan:Connect(function(input)
        if busy then return end
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            resizing={Input=input,Start=input.Position,Size=frame.Size,Position=frame.Position,Edge=edge}
        end
    end)
end
track(UIS.InputChanged,function(input)
    if not resizing then return end
    if input.UserInputType~=Enum.UserInputType.MouseMovement and input~=resizing.Input then return end
    local s=frame.ResponsiveScale.Scale
    local delta=(input.Position-resizing.Start)/s
    local e=resizing.Edge
    local dx=(e=="Right" or e=="BottomRight") and delta.X or e=="Left" and -delta.X or 0
    local dy=(e=="Bottom" or e=="BottomRight") and delta.Y or e=="Top" and -delta.Y or 0
    local camera=workspace.CurrentCamera
    local viewport=camera and camera.ViewportSize or Vector2.new(1920,1080)
    local w=math.clamp(resizing.Size.X.Offset+dx,420,math.max(420,(viewport.X-24)/s))
    local h=math.clamp(resizing.Size.Y.Offset+dy,240,math.max(240,(viewport.Y-24)/s))
    local shiftX=(w-resizing.Size.X.Offset)*s*.5*(e=="Left" and -1 or 1)
    local shiftY=(h-resizing.Size.Y.Offset)*s*.5*(e=="Top" and -1 or 1)
    frame.Size=UDim2.fromOffset(w,h)
    frame.Position=resizing.Position+UDim2.fromOffset(shiftX,shiftY)
end)
track(UIS.InputEnded,function(input) if resizing and (input==resizing.Input or input.UserInputType==Enum.UserInputType.MouseButton1) then resizing=nil end end)
revealLogo()

