			valueScroller.BorderSizePixel = 0
			valueScroller.ClipsDescendants = true
			valueScroller.Active = true
			valueScroller.ScrollingDirection = Enum.ScrollingDirection.X
			valueScroller.AutomaticCanvasSize = Enum.AutomaticSize.X
			valueScroller.CanvasSize = UDim2.new()
			valueScroller.ScrollBarThickness = 0
			local valueCorner = Instance.new("UICorner", valueScroller)
			valueCorner.CornerRadius = UDim.new(0, 6)
			local valueStroke = Instance.new("UIStroke", valueScroller)
			valueStroke.Color = Color3.new(1, 1, 1)
			valueStroke.Transparency = 1

			local valueBox = Instance.new("TextBox", valueScroller)
			valueBox.Name = "Value"
			valueBox.Position = UDim2.fromOffset(0, 0)
			valueBox.Size = UDim2.fromOffset(56, 28)
			valueBox.BackgroundTransparency = 1
			valueBox.BorderSizePixel = 0
			valueBox.ClearTextOnFocus = false
			valueBox.FontFace = Ubuntu
			valueBox.TextColor3 = Color3.fromRGB(235, 235, 240)
			valueBox.TextSize = 13
			valueBox.TextXAlignment = Enum.TextXAlignment.Left
			local valuePadding = Instance.new("UIPadding", valueBox)
			valuePadding.PaddingLeft = UDim.new(0, 6)
			valuePadding.PaddingRight = UDim.new(0, 6)
			local function updateValueWidth()
				valueBox.Size = UDim2.fromOffset(math.max(56, valueBox.TextBounds.X + 12), 28)
			end
			valueBox:GetPropertyChangedSignal("TextBounds"):Connect(updateValueWidth)
			updateValueWidth()

			local api = {
				Instance = component,
				Title = sliderTitle,
				Description = sliderDescription,
				Track = track,
				ValueBox = valueBox,
				Value = value,
			}
			local function format(number)
				return string.format("%." .. decimals .. "f", number)
			end
			function api:Set(number, skipCallback)
				number = tonumber(number)
				if not number then
					number = value
				end
				number = minimum + math.floor(((number - minimum) / increment) + 0.5) * increment
				number = math.clamp(number, minimum, maximum)
				number = tonumber(format(number))
				value = number
				self.Value = number
				local alpha = maximum == minimum and 0 or (number - minimum) / (maximum - minimum)
				local info = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				TweenService:Create(fill, info, { Size = UDim2.fromScale(alpha, 1) }):Play()
				TweenService:Create(knob, info, { Position = UDim2.fromScale(alpha, 0.5) }):Play()
				valueBox.Text = format(number)
				if not skipCallback then
					Window:SaveConfig(flag, number)
				end
				if not skipCallback and type(sliderConfig.Callback) == "function" then
					task.spawn(sliderConfig.Callback, number)
				end
			end
			function api:Get()
				return value
			end
			local draggingSlider = false
			local function setFromX(x)
				local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				api:Set(minimum + (maximum - minimum) * alpha)
			end
			track.InputBegan:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					draggingSlider = true
					setFromX(input.Position.X)
					TweenService:Create(knob, TweenInfo.new(0.14), { Size = UDim2.fromOffset(17, 17) }):Play()
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if
					draggingSlider
					and (
						input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch
					)
				then
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if
					draggingSlider
					and (
						input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch
					)
				then
					draggingSlider = false
					TweenService:Create(knob, TweenInfo.new(0.18), { Size = UDim2.fromOffset(14, 14) }):Play()
				end
			end)
			valueBox.Focused:Connect(function()
				TweenService:Create(valueBox, TweenInfo.new(0.16), { TextColor3 = Color3.new(1, 1, 1) }):Play()
			end)
			valueBox.FocusLost:Connect(function(enterPressed)
				TweenService:Create(valueBox, TweenInfo.new(0.16), { TextColor3 = Color3.fromRGB(235, 235, 240) })
					:Play()
				api:Set(valueBox.Text)
			end)
			component.MouseEnter:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(38, 38, 41) })
					:Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.9 }):Play()
			end)
			component.MouseLeave:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(35, 35, 37) })
					:Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.94 }):Play()
			end)
			api:Set(value, true)
			if loadedValue ~= nil and type(sliderConfig.Callback) == "function" then
				task.defer(sliderConfig.Callback, value)
			end
			animateIn(component)
			table.insert(self._items, api)
			self:_registerComponent(api.Instance)
			return api
		end
		function tab:AddDropdown(dropdownConfig)
			if type(dropdownConfig) == "string" then
				dropdownConfig = { Title = dropdownConfig }
			end
			dropdownConfig = dropdownConfig or {}
			local flag = dropdownConfig.Flag or (self.Title.Text .. "." .. (dropdownConfig.Title or "Dropdown"))
			local loadedValue = Window._config[flag]
			local multi = dropdownConfig.Multi == true
			local opened = false
			local selected = {}
			local optionRows = {}
			local baseHeight = 58

			local component = Instance.new("Frame", self.Page)
			component.Name = (dropdownConfig.Title or "Dropdown") .. "Dropdown"
			component.Size = UDim2.new(1, 0, 0, baseHeight)
			component.BackgroundColor3 = Color3.fromRGB(35, 35, 37)
			component.BorderSizePixel = 0
			component.ClipsDescendants = true
			component.ClipsDescendants = true
			component.LayoutOrder = #self._items + 1
			local componentCorner = Instance.new("UICorner", component)
			componentCorner.CornerRadius = UDim.new(0, 7)
			local componentStroke = Instance.new("UIStroke", component)
			componentStroke.Color = Color3.new(1, 1, 1)
			componentStroke.Transparency = 0.94

			local header = Instance.new("TextButton", component)
			header.Name = "Header"
			header.Size = UDim2.new(1, 0, 0, baseHeight)
			header.BackgroundTransparency = 1
			header.Text = ""
			header.AutoButtonColor = false

			local dropdownTitle = Instance.new("TextLabel", header)
			dropdownTitle.Name = "Title"
			dropdownTitle.Position = UDim2.fromOffset(14, 7)
			dropdownTitle.Size = UDim2.new(1, -205, 0, 20)
			dropdownTitle.BackgroundTransparency = 1
			dropdownTitle.FontFace = UbuntuMedium
			dropdownTitle.Text = dropdownConfig.Title or "Dropdown"
			dropdownTitle.TextColor3 = Color3.fromRGB(225, 225, 230)
			dropdownTitle.TextSize = 16
			dropdownTitle.TextXAlignment = Enum.TextXAlignment.Left

			local dropdownDescription = Instance.new("TextLabel", header)
			dropdownDescription.Name = "Description"
			dropdownDescription.Position = UDim2.fromOffset(14, 24)
			dropdownDescription.Size = UDim2.new(1, -205, 0, 18)
			dropdownDescription.BackgroundTransparency = 1
			dropdownDescription.FontFace = Ubuntu
			dropdownDescription.Text = dropdownConfig.Description or ""
			dropdownDescription.TextColor3 = Color3.fromRGB(125, 125, 132)
			dropdownDescription.TextSize = 13
			dropdownDescription.TextXAlignment = Enum.TextXAlignment.Left
			dropdownDescription.TextTruncate = Enum.TextTruncate.None

			local current = Instance.new("TextLabel", header)
			current.Name = "Current"
			current.AnchorPoint = Vector2.new(1, 0.5)
			current.Position = UDim2.new(1, -43, 0.5, 0)
			current.Size = UDim2.fromOffset(125, 24)
			current.BackgroundTransparency = 1
			current.FontFace = Ubuntu
			current.Text = dropdownConfig.Placeholder or "Select"
			current.TextColor3 = Color3.fromRGB(155, 155, 162)
			current.TextSize = 13
			current.TextTruncate = Enum.TextTruncate.None
			current.TextXAlignment = Enum.TextXAlignment.Right

			local arrow = Instance.new("ImageLabel", header)
			arrow.Name = "Icon"
			arrow.AnchorPoint = Vector2.new(0.5, 0.5)
			arrow.Position = UDim2.new(1, -22, 0.5, 0)
			arrow.Size = UDim2.fromOffset(18, 18)
			arrow.BackgroundTransparency = 1
			arrow.Image = getCustomIcon("lucide-chevron-down.png")
			arrow.ImageColor3 = Color3.fromRGB(225, 225, 230)

			local optionsHolder = Instance.new("ScrollingFrame", component)
			optionsHolder.Name = "Options"
			optionsHolder.Position = UDim2.fromOffset(8, baseHeight)
			optionsHolder.Size = UDim2.new(1, -16, 0, 0)
			optionsHolder.BackgroundTransparency = 1
			optionsHolder.BorderSizePixel = 0
			optionsHolder.ScrollBarThickness = 0
			optionsHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
			optionsHolder.CanvasSize = UDim2.new()
			local optionsLayout = Instance.new("UIListLayout", optionsHolder)
			optionsLayout.Padding = UDim.new(0, 4)
			optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder

			local api = {
				Instance = component,
				Title = dropdownTitle,
				Description = dropdownDescription,
				Options = optionsHolder,
				Value = multi and {} or nil,
			}
			local function optionValue(option)
				if type(option) == "table" then
					return option.Value ~= nil and option.Value or option.Title
				end
				return option
			end
			local function optionTitle(option)
				return type(option) == "table" and tostring(option.Title or option.Value or "Option")
					or tostring(option)
			end
			local function optionDescription(option)
				return type(option) == "table" and tostring(option.Description or "") or ""
			end
			local function isSelected(value)
				return selected[value] == true
			end
			local function updateCurrent()
				local names = {}
				for _, data in ipairs(optionRows) do
					if isSelected(data.Value) then
						table.insert(names, data.Title)
					end
				end
				current.Text = #names > 0 and table.concat(names, ", ") or (dropdownConfig.Placeholder or "Select")
				if multi then
					local values = {}
					for _, data in ipairs(optionRows) do
						if isSelected(data.Value) then
							table.insert(values, data.Value)
						end
					end
					api.Value = values
				else
					api.Value = nil
					for _, data in ipairs(optionRows) do
						if isSelected(data.Value) then
							api.Value = data.Value
							break
						end
					end
				end
			end
			local function updateRows()
				for _, data in ipairs(optionRows) do
					local active = isSelected(data.Value)
					local info = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
					TweenService:Create(data.Row, info, { BackgroundTransparency = active and 0.82 or 1 }):Play()
					TweenService:Create(data.Check, info, { ImageTransparency = active and 0.05 or 1 }):Play()
					TweenService:Create(data.Label, info, {
						TextColor3 = active and Color3.fromRGB(225, 225, 230) or Color3.fromRGB(190, 190, 195),
					}):Play()
					TweenService:Create(data.Stroke, info, { Transparency = active and 0.93 or 1 }):Play()
					TweenService:Create(data.Scale, info, { Scale = active and 1.003 or 1 }):Play()
					if data.Shadow then
						TweenService:Create(data.Shadow, info, { Transparency = active and 0.82 or 1 }):Play()
					end
				end
				updateCurrent()
			end
			local function emit()
				if type(dropdownConfig.Callback) == "function" then
					local output = api.Value
					if multi then
						output = table.clone(api.Value)
					end
					task.spawn(dropdownConfig.Callback, output)
				end
			end
			function api:Set(newValue, skipCallback)
				table.clear(selected)
				if multi then
					if type(newValue) == "table" then
						for _, value in ipairs(newValue) do
							selected[value] = true
						end
					elseif newValue ~= nil then
						selected[newValue] = true
					end
				elseif newValue ~= nil then
					selected[newValue] = true
				end
				updateRows()
				if not skipCallback then
					Window:SaveConfig(flag, multi and table.clone(api.Value) or api.Value)
					emit()
				end
			end
			function api:Get()
				return multi and table.clone(self.Value) or self.Value
			end
			function api:SetOpen(state)
				opened = state == true
				local visibleHeight = math.min(#optionRows * 46, 184)
				local targetHeight = opened and baseHeight + visibleHeight + 8 or baseHeight
				local info = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				TweenService:Create(component, info, { Size = UDim2.new(1, 0, 0, targetHeight) }):Play()
				TweenService:Create(optionsHolder, info, { Size = UDim2.new(1, -16, 0, opened and visibleHeight or 0) })
					:Play()
				TweenService:Create(arrow, info, { Rotation = opened and 180 or 0 }):Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = opened and 0.86 or 0.94 })
					:Play()
			end
			function api:Reload(newOptions)
				for _, data in ipairs(optionRows) do
					data.Row:Destroy()
				end
				table.clear(optionRows)
				local source = newOptions
				if source == nil then
					source = dropdownConfig.Options or {}
					if type(source) == "function" then
						local ok, result = pcall(source)
						source = ok and result or {}
					end
				end
				if type(source) ~= "table" then
					source = {}
				end
				for index, option in ipairs(source) do
					local value = optionValue(option)
					local row = Instance.new("TextButton", optionsHolder)
					row.Name = optionTitle(option) .. "Option"
					row.Size = UDim2.new(1, -3, 0, 42)
					row.BackgroundColor3 = Color3.fromRGB(46, 46, 50)
					row.BackgroundTransparency = 1
					row.BorderSizePixel = 0
					row.Text = ""
					row.AutoButtonColor = false
					row.LayoutOrder = index
					local rowCorner = Instance.new("UICorner", row)
					rowCorner.CornerRadius = UDim.new(0, 6)
					local rowStroke = Instance.new("UIStroke", row)
					rowStroke.Color = Color3.fromRGB(255, 255, 255)
					rowStroke.Transparency = 1
					local selectionScale = Instance.new("UIScale", row)
					selectionScale.Scale = 1
					local rowShadow
					pcall(function()
						rowShadow = Instance.new("UIShadow", row)
						rowShadow.BlurRadius = UDim.new(0, 10)
						rowShadow.Color = Color3.new()
						rowShadow.Transparency = 1
						rowShadow.ZIndex = -1
						rowShadow.ShowBehindParent = true
					end)
					local label = Instance.new("TextLabel", row)
					label.Name = "Title"
					label.Position = UDim2.fromOffset(10, 3)
					label.Size = UDim2.new(1, -45, 0, 19)
					label.BackgroundTransparency = 1
					label.FontFace = UbuntuMedium
					label.Text = optionTitle(option)
					label.TextColor3 = Color3.fromRGB(190, 190, 195)
					label.TextSize = 14
					label.TextXAlignment = Enum.TextXAlignment.Left
					local desc = Instance.new("TextLabel", row)
					desc.Name = "Description"
					desc.Position = UDim2.fromOffset(10, 20)
					desc.Size = UDim2.new(1, -45, 0, 17)
					desc.BackgroundTransparency = 1
					desc.FontFace = Ubuntu
					desc.Text = optionDescription(option)
					desc.TextColor3 = Color3.fromRGB(115, 115, 122)
					desc.TextSize = 12
					desc.TextXAlignment = Enum.TextXAlignment.Left
					desc.TextTruncate = Enum.TextTruncate.None
					local check = Instance.new("ImageLabel", row)
					check.Name = "Check"
					check.AnchorPoint = Vector2.new(0.5, 0.5)
					check.Position = UDim2.new(1, -17, 0.5, 0)
					check.Size = UDim2.fromOffset(17, 17)
					check.BackgroundTransparency = 1
					check.Image = getCustomIcon("lucide-check.png")
					check.ImageColor3 = Color3.fromRGB(225, 225, 230)
					check.ImageTransparency = 1
					local data = {
						Row = row,
						Label = label,
						Description = desc,
						Check = check,
						Stroke = rowStroke,
						Scale = selectionScale,
						Shadow = rowShadow,
						Value = value,
						Title = optionTitle(option),
					}
					table.insert(optionRows, data)
					row.MouseButton1Click:Connect(function()
						if multi then
							selected[value] = not isSelected(value)
						else
							table.clear(selected)
							selected[value] = true
							api:SetOpen(false)
						end
						updateRows()
						emit()
					end)
					row.MouseEnter:Connect(function()
						if not isSelected(value) then
							TweenService:Create(row, TweenInfo.new(0.18), { BackgroundTransparency = 0.84 }):Play()
						end
					end)
					row.MouseLeave:Connect(function()
						if not isSelected(value) then
							TweenService:Create(row, TweenInfo.new(0.14), { BackgroundTransparency = 1 }):Play()
						end
					end)
				end
				updateRows()
				if opened then
					api:SetOpen(true)
				end
			end
			header.MouseButton1Click:Connect(function()
				api:SetOpen(not opened)
			end)
			header.MouseEnter:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(38, 38, 41) })
					:Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.9 }):Play()
			end)
			header.MouseLeave:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(35, 35, 37) })
					:Play()
				if not opened then
					TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.94 }):Play()
				end
			end)
			api:Reload()
			api:Set(Window:GetConfig(flag, dropdownConfig.Default), true)
			if loadedValue ~= nil and type(dropdownConfig.Callback) == "function" then
				task.defer(dropdownConfig.Callback, api:Get())
			end
			if dropdownConfig.AutoReload then
				task.spawn(function()
					local interval = math.max(tonumber(dropdownConfig.ReloadInterval) or 2, 0.2)
					while component.Parent do
						task.wait(interval)
						if component.Parent then
							api:Reload()
						end
					end
				end)
			end
			animateIn(component)
			table.insert(self._items, api)
			self:_registerComponent(api.Instance)
			return api
		end
		function tab:AddInput(inputConfig)
			if type(inputConfig) == "string" then
				inputConfig = { Title = inputConfig }
			end
			inputConfig = inputConfig or {}

			local component = Instance.new("Frame", self.Page)
			component.Name = (inputConfig.Title or "Input") .. "Input"
			component.Size = UDim2.new(1, 0, 0, 58)
			component.BackgroundColor3 = Color3.fromRGB(35, 35, 37)
			component.BorderSizePixel = 0
			component.ClipsDescendants = true
			component.LayoutOrder = #self._items + 1
			local componentCorner = Instance.new("UICorner", component)
			componentCorner.CornerRadius = UDim.new(0, 7)
			local componentStroke = Instance.new("UIStroke", component)
			componentStroke.Color = Color3.new(1, 1, 1)
			componentStroke.Transparency = 0.94

			local inputTitle = Instance.new("TextLabel", component)
			inputTitle.Name = "Title"
			inputTitle.Position = UDim2.fromOffset(14, 7)
			inputTitle.Size = UDim2.new(1, -205, 0, 20)
			inputTitle.BackgroundTransparency = 1
			inputTitle.FontFace = UbuntuMedium
			inputTitle.Text = inputConfig.Title or "Input"
			inputTitle.TextColor3 = Color3.fromRGB(225, 225, 230)
			inputTitle.TextSize = 16
			inputTitle.TextXAlignment = Enum.TextXAlignment.Left

			local inputDescription = Instance.new("TextLabel", component)
			inputDescription.Name = "Description"
			inputDescription.Position = UDim2.fromOffset(14, 24)
			inputDescription.Size = UDim2.new(1, -205, 0, 18)
			inputDescription.BackgroundTransparency = 1
			inputDescription.FontFace = Ubuntu
			inputDescription.Text = inputConfig.Description or ""
			inputDescription.TextColor3 = Color3.fromRGB(125, 125, 132)
			inputDescription.TextSize = 13
			inputDescription.TextXAlignment = Enum.TextXAlignment.Left
			inputDescription.TextTruncate = Enum.TextTruncate.None

			local inputScroller = Instance.new("ScrollingFrame", component)
			inputScroller.Name = "TextScroller"
			inputScroller.AnchorPoint = Vector2.new(1, 0.5)
			inputScroller.Position = UDim2.new(1, -14, 0.5, 0)
			inputScroller.Size = UDim2.fromOffset(178, 30)
			inputScroller.BackgroundTransparency = 1
			inputScroller.BorderSizePixel = 0
			inputScroller.ClipsDescendants = true
			inputScroller.Active = true
			inputScroller.ScrollingDirection = Enum.ScrollingDirection.X
			inputScroller.AutomaticCanvasSize = Enum.AutomaticSize.X
			inputScroller.CanvasSize = UDim2.new()
			inputScroller.ScrollBarThickness = 0

			local textBox = Instance.new("TextBox", inputScroller)
			textBox.Name = "TextBox"
			textBox.Position = UDim2.fromOffset(0, 0)
			textBox.Size = UDim2.fromOffset(178, 30)
			textBox.BackgroundTransparency = 1
			textBox.BorderSizePixel = 0
			textBox.ClearTextOnFocus = false
			textBox.FontFace = Ubuntu
			textBox.Text = tostring(inputConfig.Default or "")
			textBox.PlaceholderText = inputConfig.Placeholder or "Type here..."
			textBox.PlaceholderColor3 = Color3.fromRGB(115, 115, 122)
			textBox.TextColor3 = Color3.fromRGB(235, 235, 240)
			textBox.TextSize = 13
			textBox.TextTruncate = Enum.TextTruncate.None
			textBox.TextXAlignment = Enum.TextXAlignment.Left
			local textPadding = Instance.new("UIPadding", textBox)
			textPadding.PaddingLeft = UDim.new(0, 10)
			textPadding.PaddingRight = UDim.new(0, 10)
			local function updateInputWidth(moveToEnd)
				textBox.Size = UDim2.fromOffset(math.max(178, textBox.TextBounds.X + 20), 30)
				if moveToEnd then
					task.defer(function()
						if inputScroller.Parent then
							inputScroller.CanvasPosition = Vector2.new(
								math.max(0, textBox.AbsoluteSize.X - inputScroller.AbsoluteSize.X),
								0
							)
						end
					end)
				end
			end
			textBox:GetPropertyChangedSignal("TextBounds"):Connect(function()
				updateInputWidth(textBox:IsFocused())
			end)
			updateInputWidth(false)
			local inputLine = Instance.new("Frame", component)
			inputLine.Name = "InputLine"
			inputLine.AnchorPoint = Vector2.new(1, 0)
			inputLine.Position = UDim2.new(1, -14, 0, 45)
			inputLine.Size = UDim2.fromOffset(178, 1)
			inputLine.BackgroundColor3 = Color3.fromRGB(115, 115, 122)
			inputLine.BackgroundTransparency = 0.45
			inputLine.BorderSizePixel = 0

			local api = {
				Instance = component,
				Title = inputTitle,
				Description = inputDescription,
				TextBox = textBox,
				Value = textBox.Text,
			}
			function api:Set(text, skipCallback)
				text = tostring(text or "")
				textBox.Text = text
				self.Value = text
				if not skipCallback and type(inputConfig.Callback) == "function" then
					task.spawn(inputConfig.Callback, text)
				end
			end
			function api:Get()
				return textBox.Text
			end
			function api:Focus()
				textBox:CaptureFocus()
			end
			textBox.Focused:Connect(function()
				TweenService:Create(
					inputLine,
					TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ BackgroundColor3 = Color3.fromRGB(190, 190, 196), BackgroundTransparency = 0.12 }
				):Play()
			end)
			textBox.FocusLost:Connect(function(enterPressed)
				api.Value = textBox.Text
				TweenService:Create(
					inputLine,
					TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ BackgroundColor3 = Color3.fromRGB(115, 115, 122), BackgroundTransparency = 0.45 }
				):Play()
				if type(inputConfig.Callback) == "function" then
					task.spawn(inputConfig.Callback, textBox.Text, enterPressed)
				end
			end)
			textBox:GetPropertyChangedSignal("Text"):Connect(function()
				api.Value = textBox.Text
				if inputConfig.Live and type(inputConfig.Callback) == "function" then
					task.spawn(inputConfig.Callback, textBox.Text, false)
				end
			end)
			component.MouseEnter:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(38, 38, 41) })
					:Play()
				TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.9 }):Play()
			end)
			component.MouseLeave:Connect(function()
				TweenService:Create(component, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(35, 35, 37) })
					:Play()
				if not textBox:IsFocused() then
					TweenService:Create(componentStroke, TweenInfo.new(0.18), { Transparency = 0.94 }):Play()
				end
			end)
			animateIn(component)
			table.insert(self._items, api)
			self:_registerComponent(api.Instance)
			return api
		end
		table.insert(self._tabs, tab)
		button.MouseEnter:Connect(function()
			if self._selected ~= tab then
				TweenService:Create(
					tabTitle,
					TweenInfo.new(0.14),
					{ TextColor3 = Color3.fromRGB(235, 235, 240), TextStrokeTransparency = 0.78 }
				):Play()
				TweenService:Create(
					tabDescription,
					TweenInfo.new(0.14),
					{ TextColor3 = Color3.fromRGB(190, 190, 195), TextStrokeTransparency = 0.9 }
				):Play()
				if tabIcon then
					TweenService:Create(
						tabIcon,
						TweenInfo.new(0.14),
						{ ImageColor3 = Color3.fromRGB(225, 225, 230), ImageTransparency = 0.05 }
					):Play()
				end
				TweenService:Create(button, TweenInfo.new(0.18), { BackgroundTransparency = 0.94 }):Play()
				TweenService:Create(buttonStroke, TweenInfo.new(0.18), { Transparency = 0.97 }):Play()
				TweenService:Create(
					buttonScale,
					TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ Scale = 1.002 }
				):Play()
				if buttonShadow then
					TweenService:Create(buttonShadow, TweenInfo.new(0.18), { Transparency = 0.88 }):Play()
				end
			end
		end)
		button.MouseLeave:Connect(function()
			if self._selected ~= tab then
				TweenService:Create(
					tabTitle,
					TweenInfo.new(0.14),
					{ TextColor3 = Color3.fromRGB(150, 150, 155), TextStrokeTransparency = 1 }
				):Play()
				TweenService:Create(
					tabDescription,
					TweenInfo.new(0.14),
					{ TextColor3 = Color3.fromRGB(105, 105, 110), TextStrokeTransparency = 1 }
				):Play()
				if tabIcon then
					TweenService:Create(
						tabIcon,
						TweenInfo.new(0.14),
						{ ImageColor3 = Color3.fromRGB(125, 125, 132), ImageTransparency = 0.25 }
					):Play()
				end
				TweenService:Create(button, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
				TweenService:Create(buttonStroke, TweenInfo.new(0.2), { Transparency = 1 }):Play()
				TweenService:Create(
					buttonScale,
					TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ Scale = 1 }
				):Play()
				if buttonShadow then
					TweenService:Create(buttonShadow, TweenInfo.new(0.2), { Transparency = 0.95 }):Play()
				end
			end
		end)
		button.MouseButton1Click:Connect(function()
			self:SelectTab(tab)
		end)
		button.MouseButton2Click:Connect(function()
			self:_showTabMenu(tab, UserInputService:GetMouseLocation())
		end)
		if #self._tabs == 1 then
			self:SelectTab(tab)
		end
		return tab
	end

	local resizeGrip = Instance.new("TextButton", frame)
	resizeGrip.Name = "ResizeGrip"
	resizeGrip.AnchorPoint = Vector2.new(1, 1)
	resizeGrip.Position = UDim2.new(1, -4, 1, -4)
	resizeGrip.Size = UDim2.fromOffset(24, 24)
	resizeGrip.BackgroundTransparency = 1
	resizeGrip.BorderSizePixel = 0
	resizeGrip.AutoButtonColor = false
	resizeGrip.FontFace = UbuntuMedium
	resizeGrip.Text = "⌟"
	resizeGrip.TextColor3 = Color3.fromRGB(130, 130, 138)
	resizeGrip.TextSize = 20
	resizeGrip.ZIndex = 30

	local resizing = false
	local resizeInput
	local resizeStart
	local sizeStart
	resizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizeInput = input
			resizeStart = input.Position
			sizeStart = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local mouseMovement = input.UserInputType == Enum.UserInputType.MouseMovement
		local touchMovement = input.UserInputType == Enum.UserInputType.Touch and input == resizeInput
		if resizing and (mouseMovement or touchMovement) then
			local delta = (input.Position - resizeStart) / responsiveScale.Scale
			local camera = workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
			local maximum = viewport / responsiveScale.Scale - Vector2.new(24, 24)
			frame.Size = UDim2.fromOffset(
				math.clamp(sizeStart.X + delta.X, 520, math.max(520, maximum.X)),
				math.clamp(sizeStart.Y + delta.Y, 320, math.max(320, maximum.Y))
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input == resizeInput then
			resizing = false
			resizeInput = nil
		end
	end)

	local dragging = false
	local dragInput
	local dragStart
	local startPosition
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and Window._contextMenu then
			Window._contextMenu:Destroy()
			Window._contextMenu = nil
		end
		if
			(input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
			and input.Position.Y <= frame.AbsolutePosition.Y + 52 * responsiveScale.Scale
		then
			dragging = true
			dragInput = input
			dragStart = input.Position
			startPosition = frame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local mouseMovement = input.UserInputType == Enum.UserInputType.MouseMovement
		local touchMovement = input.UserInputType == Enum.UserInputType.Touch and input == dragInput
		if dragging and (mouseMovement or touchMovement) then
			local delta = (input.Position - dragStart) / responsiveScale.Scale
			frame.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput then
			dragging = false
			dragInput = nil
		end
	end)

	TweenService:Create(frame, TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = targetPosition,
	}):Play()

	return Window
end

return Library














