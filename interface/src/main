			controls.BackgroundTransparency = 1

			local track = Instance.new("TextButton", controls)
			track.Name = "Track"
			track.Position = UDim2.fromOffset(0, 13)
			track.Size = UDim2.fromOffset(113, 6)
			track.BackgroundColor3 = Color3.fromRGB(65, 65, 70)
			track.BorderSizePixel = 0
			track.Text = ""
