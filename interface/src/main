		local tab = {
			Button = button,
			Icon = tabIcon,
			Title = tabTitle,
			Description = tabDescription,
			Page = page,
			Stroke = buttonStroke,
			Scale = buttonScale,
			Shadow = buttonShadow,
			PinStar = tabPinStar,
			Pinned = false,
			_items = {},
			_contextItems = {},
		}
		function tab:_refreshComponentOrder()
			for index, item in ipairs(self._contextItems) do
				item.Instance.LayoutOrder = index
			end
		end
		function tab:_moveComponent(item, direction)
			local index = table.find(self._contextItems, item)
			local target = index and index + direction
			local neighbour = target and self._contextItems[target]
			if not index or not neighbour or neighbour.Pinned ~= item.Pinned then
				return
			end
			self._contextItems[index], self._contextItems[target] = self._contextItems[target], self._contextItems[index]
			self:_refreshComponentOrder()
		end
		function tab:_setComponentPinned(item, pinned)
			local index = table.find(self._contextItems, item)
			if not index then
				return
			end
			table.remove(self._contextItems, index)
			item.Pinned = pinned == true
			item.PinStar.Visible = item.Pinned
			local insertAt = 1
			while self._contextItems[insertAt] and self._contextItems[insertAt].Pinned do
				insertAt += 1
			end
			table.insert(self._contextItems, insertAt, item)
			self:_refreshComponentOrder()
		end
		function tab:_registerComponent(instance)
			local pinStar = Instance.new("ImageLabel", instance)
			pinStar.Name = "PinStar"
			pinStar.Size = UDim2.fromOffset(15, 15)
			pinStar.BackgroundTransparency = 1
			pinStar.Image = getCustomIcon("lucide-star.png")
			pinStar.ImageColor3 = Color3.fromRGB(225, 225, 230)
			pinStar.Visible = false
			pinStar.ZIndex = 20
			pinStar.AnchorPoint = Vector2.new(0.5, 0.5)
			local layout = instance:FindFirstChildOfClass("UIListLayout")
			local titleHolder = instance:FindFirstChild("Title")
			if layout and titleHolder and titleHolder:IsA("GuiObject") then
				pinStar.Parent = titleHolder
				pinStar.Position = UDim2.new(1, -9, 0.5, 0)
			else
				pinStar.Position = UDim2.new(1, -22, 0, 17)
			end
			local item = {
				Button = instance,
				Instance = instance,
				Pinned = false,
				PinStar = pinStar,
			}
			table.insert(self._contextItems, item)
			self:_refreshComponentOrder()
			local lastOpened = 0
			local function connectContext(object)
				if not object:IsA("GuiObject") then
					return
				end
				object.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					if os.clock() - lastOpened < 0.05 then
						return
					end
					lastOpened = os.clock()
					Window:_showTabMenu(item, input.Position, {
						Pin = function()
							self:_setComponentPinned(item, not item.Pinned)
						end,
						Move = function(direction)
							self:_moveComponent(item, direction)
						end,
					})
				end
				end)
			end
			connectContext(instance)
			for _, object in ipairs(instance:GetDescendants()) do
				connectContext(object)
			end
			instance.DescendantAdded:Connect(connectContext)
			return item
		end
		function tab:Select()
			Window:SelectTab(self)
		end
