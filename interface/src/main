		local function themeAccent()
 return frame:GetAttribute("BackgroundAccentColor") or Color3.fromRGB(75,113,125)
end
local function themeBoxColor()
 local base=frame:GetAttribute("BackgroundBaseColor") or Color3.fromRGB(20,20,21)
 return Color3.fromRGB(25,25,25)
end
local function themeBox(object)
 object.BackgroundTransparency=0
 object.BackgroundColor3=themeBoxColor()
 task.defer(function()
 local title=object:FindFirstChild("Title")
 local description=object:FindFirstChild("Description")
 if title and description then
  local function alignText()
   if not object.Parent then return end
   local scale=math.max(frame.ResponsiveScale.Scale,.01)
   local lines=description.Text=="" and 0 or (description.TextBounds.Y/scale>18 and 2 or 1)
   local height=lines==0 and 0 or lines==2 and 28 or 16
   local top=math.floor((object.Size.Y.Offset-20-height)/2)
   title.Position=UDim2.fromOffset(12,top)
   description.Position=UDim2.fromOffset(12,top+20)
   local size=description.Size
   description.Size=UDim2.new(size.X.Scale,size.X.Offset,0,height)
  end
  description:GetPropertyChangedSignal("TextBounds"):Connect(alignText)
  description:GetPropertyChangedSignal("Text"):Connect(alignText)
  task.defer(alignText)
 end
 end)
 local function refresh()
  if object.Parent then TweenService:Create(object,TweenInfo.new(.2),{BackgroundColor3=themeBoxColor()}):Play() end
 end
 track(frame:GetAttributeChangedSignal("BackgroundBaseColor"),refresh)
 track(frame:GetAttributeChangedSignal("BackgroundAccentColor"),refresh)
end
function tab:AddToggle(toggleConfig)
			if type(toggleConfig) == "string" then
				toggleConfig = { Title = toggleConfig }
			end
			toggleConfig = toggleConfig or {}
			local flag = toggleConfig.Flag or (self.Title.Text .. "." .. (toggleConfig.Title or "Toggle"))
			local loadedValue = Window._config[flag]
			local enabled = Window:GetConfig(flag, toggleConfig.Default == true) == true
			local toggle = Instance.new("TextButton", self.Page)
			toggle.Name = (toggleConfig.Title or "Toggle") .. "Toggle"
			toggle.Size = UDim2.new(1, 0, 0, 58)
			toggle.BackgroundColor3 = themeBoxColor()
			toggle.BorderSizePixel = 0
            themeBox(toggle)
			toggle.ClipsDescendants = true
			toggle.Text = ""
			toggle.AutoButtonColor = false
			toggle.LayoutOrder = #self._items + 1
			local toggleCorner = Instance.new("UICorner", toggle)
			toggleCorner.CornerRadius = UDim.new(0, 7)
			local toggleStroke = Instance.new("UIStroke", toggle)
			toggleStroke.Color = Color3.fromRGB(255, 255, 255)
			toggleStroke.Transparency = 1
			toggleStroke.Thickness = 1
            toggleStroke.Enabled = false

			local toggleTitle = Instance.new("TextLabel", toggle)
			toggleTitle.Name = "Title"
			toggleTitle.Position = UDim2.fromOffset(12, 8)
			toggleTitle.Size = UDim2.new(1, -76, 0, 20)
			toggleTitle.BackgroundTransparency = 1
			toggleTitle.Font = Enum.Font.GothamBold
			toggleTitle.Text = toggleConfig.Title or "Toggle"
			toggleTitle.TextColor3 = Color3.fromRGB(225, 225, 230)
			toggleTitle.TextSize = 15
			toggleTitle.TextXAlignment = Enum.TextXAlignment.Left

			local toggleDescription = Instance.new("TextLabel", toggle)
			toggleDescription.Name = "Description"
			toggleDescription.Position = UDim2.fromOffset(12, 25)
			toggleDescription.Size = UDim2.new(1, -76, 0, 28)
			toggleDescription.BackgroundTransparency = 1
			toggleDescription.Font = Enum.Font.GothamMedium
			toggleDescription.Text = toggleConfig.Description or ""
			toggleDescription.TextColor3 = Color3.fromRGB(155, 155, 155)
			toggleDescription.TextSize = 13
			toggleDescription.TextXAlignment = Enum.TextXAlignment.Left
			toggleDescription.TextWrapped = true
toggleDescription.TextYAlignment = Enum.TextYAlignment.Top
toggleDescription.TextTruncate = Enum.TextTruncate.AtEnd

			local switch = Instance.new("Frame", toggle)
			switch.Name = "Switch"
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -14, 0.5, 0)
			switch.Size = UDim2.fromOffset(36, 20)
			switch.BackgroundColor3 = enabled and Color3.fromRGB(240,240,240) or Color3.fromRGB(60,62,66)
			switch.BorderSizePixel = 0
			local switchCorner = Instance.new("UICorner", switch)
			switchCorner.CornerRadius = UDim.new(1, 0)
			local knob = Instance.new("Frame", switch)
			knob.Name = "Knob"
			knob.AnchorPoint = Vector2.new(0.5, 0.5)
			knob.Position = enabled and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
			knob.Size = UDim2.fromOffset(14, 14)
			knob.BackgroundColor3 = enabled and Color3.fromRGB(38, 38, 40) or Color3.fromRGB(215, 215, 220)
			knob.BorderSizePixel = 0
			local knobCorner = Instance.new("UICorner", knob)
			knobCorner.CornerRadius = UDim.new(1, 0)

			local api = {
				Instance = toggle,
				Title = toggleTitle,
				Description = toggleDescription,
				Switch = switch,
				Value = enabled,
			}
			function api:Set(value, skipCallback)
				enabled = value == true
				self.Value = enabled
				local info = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				TweenService:Create(switch, info, {
					BackgroundColor3 = enabled and Color3.fromRGB(240,240,240) or Color3.fromRGB(60,62,66),
				}):Play()
				TweenService:Create(knob, info, {
					Position = enabled and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0),
					BackgroundColor3 = enabled and Color3.fromRGB(38, 38, 40) or Color3.fromRGB(215, 215, 220),
				}):Play()
				TweenService:Create(toggleStroke, TweenInfo.new(0.2), { Transparency = 1 })
					:Play()
				if not skipCallback then
					Window:SaveConfig(flag, enabled)
				end
				if not skipCallback and type(toggleConfig.Callback) == "function" then
					task.spawn(toggleConfig.Callback, enabled)
				end
			end
			function api:Get()
				return enabled
			end
			track(frame:GetAttributeChangedSignal("BackgroundAccentColor"),function() if toggle.Parent then TweenService:Create(switch,TweenInfo.new(.2),{BackgroundColor3=enabled and Color3.fromRGB(240,240,240) or Color3.fromRGB(60,62,66)}):Play() end end)
            toggle.MouseButton1Click:Connect(function()
				api:Set(not enabled)
			end)
			toggle.MouseEnter:Connect(function()
				TweenService:Create(toggle, TweenInfo.new(0.18), { BackgroundColor3 = themeBoxColor() })
					:Play()
				TweenService:Create(toggleStroke, TweenInfo.new(0.18), { Transparency = 1 })
					:Play()
			end)
			toggle.MouseLeave:Connect(function()
				TweenService:Create(toggle, TweenInfo.new(0.18), { BackgroundColor3 = themeBoxColor() })
					:Play()
				TweenService:Create(toggleStroke, TweenInfo.new(0.18), { Transparency = 1 })
					:Play()
			end)
			if loadedValue ~= nil and type(toggleConfig.Callback) == "function" then
				task.defer(toggleConfig.Callback, enabled)
			end
			animateIn(toggle)
			table.insert(self._items, api)
			self:_registerComponent(api.Instance)
			return api
		end
		function tab:AddButton(buttonConfig)
			if type(buttonConfig) == "string" then
				buttonConfig = { Title = buttonConfig }
			end
			buttonConfig = buttonConfig or {}
			local component = Instance.new("TextButton", self.Page)
