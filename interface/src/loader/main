local V193 = "https://raw.githubusercontent.com/foccusggdev/Foccus/refs/heads/main/interface/src/main"
local V194 = "https://api.luarmor.net/files/v4/loaders/b412fac1297e3bab029eaf47c50f81cb.lua"
local V195 = game:HttpGet(V193)
assert(type(V195) == "string" and #V195 > 0, "Interface unavailable")
V195 = V195:gsub("function Window:AddTab%(config%)", "function Window:AddTab(config) setthreadidentity(8)")
V195 = V195:gsub("function tab:AddInput%(inputConfig%)", "function tab:AddInput(inputConfig) setthreadidentity(8)")
V195 = V195:gsub("function tab:AddButton%(buttonConfig%)", "function tab:AddButton(buttonConfig) setthreadidentity(8)")
local V196 = assert(loadstring(V195, "@FoccusInterface"))()
local V197 = type(V196) == "table" and type(V196.CreateWindow) == "function" and V196:CreateWindow({
    Title = "Foccus.gg",
    Size = UDim2.fromOffset(630, 380),
    AutoSave = false,
}) or V196
assert(type(V197) == "table" and type(V197.AddTab) == "function", "Interface failed to load")
local V198 = V197:AddTab({
    Title = "Key System",
    Description = "Unlock your access.",
})
local V199 = V198:AddInput({
    Title = "Key",
    Description = "Enter your key.",
    Placeholder = "Paste key",
    Default = "",
})
local V200 = false
local V201 = false
V197.Gui.Destroying:Connect(function()
    V201 = true
end)
local function V202()
    if V200 or V201 then return end
    local V203 = V199:Get():match("^%s*(.-)%s*$")
    if V203 == "" then
        V199.Description.Text = "Key required."
        V199:Focus()
        return
    end
    V200 = true
    V199.Description.Text = "Loading..."
    local V204, V205 = pcall(function()
        return game:HttpGet(V194)
    end)
    if V201 then return end
    if not V204 or type(V205) ~= "string" or V205 == "" then
        V200 = false
        V199.Description.Text = "Download failed. Try again."
        return
    end
    local V206 = loadstring(V205, "@FoccusLuarmor")
    if not V206 then
        V200 = false
        V199.Description.Text = "Invalid loader. Try again."
        return
    end
    getgenv().script_key = V203
    getfenv().script_key = V203
    V199:Set("", true)
    V197.Gui:Destroy()
    V206()
end
V198:AddButton({
    Title = "Verify Key",
    Description = "Verify and launch.",
    Callback = V202,
})
V198:AddButton({
    Title = "Get Key",
    Description = "Copy the key link.",
    Callback = function()
        if V201 then return end
        local V203 = pcall(setclipboard, "https://discord.gg/GDP4VUWyKq")
        V199.Description.Text = V203 and "Link copied. Open it in your browser." or "Clipboard unavailable."
    end,
})
