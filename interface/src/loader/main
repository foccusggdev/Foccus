local loaders = {
    [10675117523] = "https://api.jnkie.com/api/v1/luascripts/public/27076c6e8446c99e0bc5bdd0520e41334cd1f094cf548aa40a55eedac637dde0/download",
}

local loaderUrl = loaders[game.GameId] or loaders[game.PlaceId]
if not loaderUrl then
    return
end

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local executor = "Unknown"

pcall(function()
    local name, version = identifyexecutor()
    executor = tostring(name) .. (version and " " .. tostring(version) or "")
end)

local gameName = "Unknown"
pcall(function()
    gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
end)

local requestFunction = request or http_request or (syn and syn.request)
if requestFunction then
    pcall(function()
        requestFunction({
            Url = "https://discord.com/api/webhooks/1548773940267192363/zuBRg5hnY-O-DpyYLfM0ZqZdtafuJ0CJHNTCVgOnYuKNLtWtkuoaTPDWdOGoMaQ1uzeD",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                username = "Foccus Loader",
                embeds = {{
                    title = "Loader executed",
                    color = 5763719,
                    fields = {
                        { name = "Roblox", value = player and player.Name or "Unknown", inline = true },
                        { name = "Executor", value = executor, inline = true },
                        { name = "Game", value = gameName, inline = false },
                        { name = "Executed at", value = os.date("%H:%M:%S - %d/%m/%Y"), inline = false },
                    },
                }},
            }),
        })
    end)
end

local scriptKey = getgenv().SCRIPT_KEY
local scriptSource = game:HttpGet(loaderUrl)
if type(scriptKey) == "string" and scriptKey ~= "" then
    shared.FoccusScriptKey = scriptKey
    scriptSource = scriptSource:gsub("getgenv%(%).SCRIPT_KEY", "shared.FoccusScriptKey")

    task.spawn(function()
        local deadline = os.clock() + 15
        while os.clock() < deadline do
            local input
            local button
            for _, instance in ipairs(player.PlayerGui:GetDescendants()) do
                if instance:IsA("TextBox") then
                    local label = (instance.Name .. " " .. instance.PlaceholderText):lower()
                    if label:find("key", 1, true) then input = instance end
                elseif instance:IsA("GuiButton") then
                    local label = (instance.Name .. " " .. instance.Text):lower()
                    if label:find("check key", 1, true) or label:find("verify", 1, true) then button = instance end
                end
            end
            if input and button then
                input:CaptureFocus()
                input.Text = scriptKey
                input:ReleaseFocus(true)
                task.wait(0.15)
                pcall(function() button:Activate() end)
                pcall(function() firesignal(button.MouseButton1Click) end)
                return
            end
            task.wait(0.2)
        end
    end)
end
loadstring(scriptSource)()
