local interfaceUrl = "https://raw.githubusercontent.com/foccusggdev/Foccus/refs/heads/main/interface/src/main"
local loaderUrl = "https://api.luarmor.net/files/v4/loaders/b412fac1297e3bab029eaf47c50f81cb.lua"
local keyApiUrl = "https://sdkapi-public.luarmor.net/library.lua"
local scriptId = "b412fac1297e3bab029eaf47c50f81cb"
local keyFile = "FoccusKey.txt"

local source = game:HttpGet(interfaceUrl)
assert(type(source) == "string" and #source > 0, "Interface unavailable")
source = source:gsub("function Window:AddTab%(config%)", "function Window:AddTab(config) setthreadidentity(8)")
source = source:gsub("function tab:AddInput%(inputConfig%)", "function tab:AddInput(inputConfig) setthreadidentity(8)")
source = source:gsub("function tab:AddButton%(buttonConfig%)", "function tab:AddButton(buttonConfig) setthreadidentity(8)")

local interface = assert(loadstring(source, "@FoccusInterface"))()
local window = type(interface) == "table" and type(interface.CreateWindow) == "function" and interface:CreateWindow({
    Title = "Foccus.gg",
    Size = UDim2.fromOffset(630, 380),
    AutoSave = false,
}) or interface
assert(type(window) == "table" and type(window.AddTab) == "function", "Interface failed to load")

local savedKey = ""
local readOk, readValue = pcall(function()
    return isfile(keyFile) and readfile(keyFile) or ""
end)
if readOk and type(readValue) == "string" then
    savedKey = readValue:match("^%s*(.-)%s*$")
end

local tab = window:AddTab({
    Title = "Key System",
    Description = "Unlock your access.",
})
local input = tab:AddInput({
    Title = "Key",
    Description = savedKey ~= "" and "Saved key found." or "Enter your key.",
    Placeholder = "Paste key",
    Default = savedKey,
})
local busy = false
local closed = false
window.Gui.Destroying:Connect(function()
    closed = true
end)

local function forgetKey()
    pcall(function()
        if isfile(keyFile) then delfile(keyFile) end
    end)
    getgenv().script_key = nil
    getfenv().script_key = nil
    input:Set("", true)
end

local function verify()
    if busy or closed then return end
    local key = input:Get():match("^%s*(.-)%s*$")
    if key == "" then
        input.Description.Text = "Key required."
        input:Focus()
        return
    end

    busy = true
    input.Description.Text = "Verifying..."
    local checkOk, status = pcall(function()
        local api = assert(loadstring(game:HttpGet(keyApiUrl), "@LuarmorKeyCheck"))()
        api.script_id = scriptId
        return api.check_key(key)
    end)

    if not checkOk or type(status) ~= "table" then
            busy = false
        input.Description.Text = "Validation failed. Try again."
        return
    end
    if status.code ~= "KEY_VALID" then
        forgetKey()
        busy = false
        input.Description.Text = status.message or "Invalid or expired key."
        return
    end

    getgenv().script_key = key
    getfenv().script_key = key
    local saveOk = pcall(writefile, keyFile, key)
    if not saveOk then
        busy = false
        input.Description.Text = "Key valid, but could not save it."
        return
    end

    local downloadOk, loaderSource = pcall(function()
        return game:HttpGet(loaderUrl)
    end)
    if not downloadOk or type(loaderSource) ~= "string" or loaderSource == "" then
        busy = false
        input.Description.Text = "Loader download failed."
        return
    end
    local loader = loadstring(loaderSource, "@FoccusLuarmor")
    if not loader then
        busy = false
        input.Description.Text = "Invalid loader."
        return
    end

    input:Set("", true)
    window.Gui:Destroy()
    loader()
end

tab:AddButton({
    Title = "Verify Key",
    Description = "Verify and launch.",
    Callback = verify,
})
tab:AddButton({
    Title = "Get Key",
    Description = "Copy the key link.",
    Callback = function()
        if closed then return end
        local copied = pcall(setclipboard, "https://discord.gg/GDP4VUWyKq")
        input.Description.Text = copied and "Link copied." or "Clipboard unavailable."
    end,
})
if savedKey ~= "" then task.defer(verify) end
