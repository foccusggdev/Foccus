local BLOX_FRUITS = "https://api.jnkie.com/api/v1/luascripts/public/866af1e2e3a708386e19afc45c53f1b70f888a635696e4159763b3083a5b345a/download"
local ANIME_BREAKER = "https://api.jnkie.com/api/v1/luascripts/public/da1d72079fe79f68dc6c7a808e13c61be8be6dc8a13d3d818c0d5a669a55735b/download"
local STEAL_AN_EGG = "https://api.jnkie.com/api/v1/luascripts/public/d016505da064e34017ec73270f106c50c0dbbf6af81e7b50c4e170ecc99682c2/download"

local loaders = {
    [2753915549] = BLOX_FRUITS,
    [85211729168715] = BLOX_FRUITS,
    [4442272183] = BLOX_FRUITS,
    [79091703265657] = BLOX_FRUITS,
    [7449423635] = BLOX_FRUITS,
    [100117331123089] = BLOX_FRUITS,
    [109928390521457] = ANIME_BREAKER,
    [107778070777162] = STEAL_AN_EGG,
}

local loaderUrl = loaders[game.GameId] or loaders[game.PlaceId]

if not loaderUrl then
    return
end

local Players = game:GetService("Players")

local player = Players.LocalPlayer

local scriptKey = getgenv().SCRIPT_KEY
local scriptSource = game:HttpGet(loaderUrl)

if type(scriptKey) == "string" and scriptKey ~= "" then
    shared.FoccusScriptKey = scriptKey

    scriptSource = scriptSource:gsub(
        "getgenv%(%).SCRIPT_KEY",
        "shared.FoccusScriptKey"
    )

    task.spawn(function()
        local deadline = os.clock() + 15

        while os.clock() < deadline do
            local input
            local button
            local roots = {
                player:FindFirstChild("PlayerGui")
            }

            pcall(function()
                local hiddenUI = gethui()

                if hiddenUI then
                    table.insert(roots, hiddenUI)
                end
            end)

            pcall(function()
                table.insert(roots, game:GetService("CoreGui"))
            end)

            for _, root in ipairs(roots) do
                if root then
                    for _, instance in ipairs(root:GetDescendants()) do
                        if instance:IsA("TextBox") then
                            local label = (
                                instance.Name
                                .. " "
                                .. instance.PlaceholderText
                            ):lower()

                            if label:find("key", 1, true) then
                                input = instance
                            end
                        elseif instance:IsA("GuiButton") then
                            local buttonText = ""

                            pcall(function()
                                buttonText = instance.Text
                            end)

                            local label = (
                                instance.Name
                                .. " "
                                .. buttonText
                            ):lower()

                            if label:find("check key", 1, true)
                                or label:find("verify key", 1, true)
                                or label:find("verify", 1, true)
                            then
                                button = instance
                            end
                        end
                    end
                end
            end

            if input and button then
                input:CaptureFocus()
                input.Text = scriptKey
                input:ReleaseFocus(true)

                task.wait(0.15)

                pcall(function()
                    button:Activate()
                end)

                if firesignal then
                    pcall(function()
                        firesignal(button.MouseButton1Click)
                    end)
                end

                return
            end

            task.wait(0.2)
        end
    end)
end

local compiledScript, compileError = loadstring(scriptSource)

if not compiledScript then
    error("Loader compilation failed: " .. tostring(compileError))
end

compiledScript()


